// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id])
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String    @unique
  emailVerified DateTime?
  username      String?   @unique
  password      String
  phoneNumber   String

  image             String?
  accounts          Account[]
  sessions          Session[]
  userOrganizations UserOrganization[]
}

model AdmissionForm {
  id               String @id @default(auto()) @map("_id") @db.ObjectId
  firstName        String
  middleName       String
  lastName         String
  emailId          String
  contactNumber    String
  dob              String
  gender           String
  fatherName       String
  fatherOccupation String
  motherName       String
  motherOccupation String
  guardianName     String
  addressLine1     String
  addressLine2     String
  nationality      String
  state            String
  district         String
  postalCode       String
  religion         String
  community        String
  caste            String
}

model EnquiryForm {
  id                    String @id @default(auto()) @map("_id") @db.ObjectId
  name                  String
  date                  String
  emailId               String
  contactNumber         String
  dob                   String
  gender                String
  age                   String
  maritalStatus         String
  fatherName            String
  fatherOccupation      String
  motherName            String
  motherOccupation      String
  guardianName          String
  guardianOccupation    String
  addressLine1          String
  addressLine2          String
  nationality           String
  state                 String
  district              String
  postalCode            String
  schoolName10th        String
  obtainedMark10th      String
  yearOfPassing10th     String
  mediumOfEducation10th String
  schoolName12th        String
  obtainedMark12th      String
  yearOfPassing12th     String
  mediumOfEducation12th String
}

model DepartmentForm {
  id               String @id @default(auto()) @map("_id") @db.ObjectId
  departmentName   String
  noOfYears        String
  departmentCode   String
  activeStatus     String
  description      String
}

model Organization {
  id          String             @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  institute   String
  description String?
  image       String?
  users       UserOrganization[]
  forms       Form[]
}

model UserOrganization {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  user           User         @relation(fields: [userId], references: [id])
  userId         String       @db.ObjectId
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String       @db.ObjectId
}

enum FormType {
  Admission
  Enquiry
  Department
}

model Form {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  createdAt      DateTime?     @default(now())
  updatedAt      DateTime?     @default(now())
  type           FormType
  json           Json
  isActive       Boolean       @default(false)
  Organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?       @db.ObjectId
}
