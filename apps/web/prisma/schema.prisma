generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(uuid()) @map("_id") @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
}

model Exam {
  id                      String      @id @default(uuid()) @map("_id") @db.Uuid
  name                    String
  createdAt               DateTime    @default(now())
  examTypeId              String      @db.Uuid
  updatedAt               DateTime    @default(now())
  isDeleted               Boolean     @default(false)
  branchId                String      @db.Uuid
  isActive                Boolean
  termId                  String      @db.Uuid
  batchId                 String      @db.Uuid
  blockMarkEntry          Boolean     @default(false)
  markEntryCorrectionDate DateTime?
  markEntryEndDate        DateTime?
  markEntryOpenDate       DateTime?
  batch                   Batch       @relation(fields: [batchId], references: [id])
  branch                  Branch      @relation(fields: [branchId], references: [id])
  examType                ExamType    @relation(fields: [examTypeId], references: [id])
  term                    Term        @relation(fields: [termId], references: [id])
  examGroup               ExamGroup[]
}

model ExamType {
  id          String   @id @default(uuid()) @map("_id") @db.Uuid
  name        String
  isActive    Boolean
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  branchId    String   @db.Uuid
  frequencyId String
  isDeleted   Boolean  @default(false)
  exam        Exam[]
  branch      Branch   @relation(fields: [branchId], references: [id])
}

model Term {
  id        String   @id @default(uuid()) @map("_id") @db.Uuid
  name      String
  isActive  Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  branchId  String   @db.Uuid
  isDeleted Boolean  @default(false)
  exam      Exam[]
  branch    Branch   @relation(fields: [branchId], references: [id])
}

model ExamGroup {
  id                   String                 @id @default(uuid()) @map("_id") @db.Uuid
  totalMarks           Int?
  classId              String                 @db.Uuid
  examId               String                 @db.Uuid
  sectionId            String                 @db.Uuid
  class                Class                  @relation(fields: [classId], references: [id])
  exam                 Exam                   @relation(fields: [examId], references: [id])
  section              Section                @relation(fields: [sectionId], references: [id])
  examSubject          ExamSubject[]
  ExamSubjectPartition ExamSubjectPartition[]
}

model ExamSubject {
  id                   String                 @id @default(uuid()) @map("_id") @db.Uuid
  subjectId            String                 @db.Uuid
  totalMarks           Decimal                @default(0) @db.Decimal
  examGroupId          String                 @db.Uuid
  convertTo            Decimal                @default(0) @db.Decimal
  minMark              Decimal                @default(0) @db.Decimal
  groupId              String                 @db.Uuid
  examGroup            ExamGroup              @relation(fields: [examGroupId], references: [id])
  group                Group                  @relation(fields: [groupId], references: [id])
  subject              Subject                @relation(fields: [subjectId], references: [id])
  examSubjectPartition ExamSubjectPartition[]
  Mark                 Mark[]
}

model ExamSubjectPartition {
  id                       String           @id @default(uuid()) @map("_id") @db.Uuid
  subjectId                String           @db.Uuid
  minMark                  Decimal          @db.Decimal
  totalMarks               Decimal          @db.Decimal
  partitionName            String?
  examSubjectId            String           @db.Uuid
  assessmentFormatId       String           @db.Uuid
  convertTo                Decimal          @db.Decimal
  dateToConduct            DateTime
  examGroupId              String           @db.Uuid
  excludeSubjectValidation Boolean          @default(false)
  order                    Int?             @default(1)
  assessmentFormat         AssessmentFormat @relation(fields: [assessmentFormatId], references: [id])
  examGroup                ExamGroup        @relation(fields: [examGroupId], references: [id])
  examSubject              ExamSubject      @relation(fields: [examSubjectId], references: [id])
  subject                  Subject          @relation(fields: [subjectId], references: [id])
  Mark                     Mark[]
}

model Mark {
  id                     String               @id @default(uuid()) @map("_id") @db.Uuid
  mark                   Decimal?             @db.Decimal
  attandance             Int?
  studentId              String               @db.Uuid
  examSubjectId          String               @db.Uuid
  examSubjectPartitionId String               @db.Uuid
  subjectId              String?              @db.Uuid
  assessmentFormatId     String?              @db.Uuid
  SubjectMasterId        String?              @db.Uuid
  userId                 String               @db.Uuid
  updatedAt              DateTime?            @default(now())
  SubjectMaster          SubjectMaster?       @relation(fields: [SubjectMasterId], references: [id])
  AssessmentFormat       AssessmentFormat?    @relation(fields: [assessmentFormatId], references: [id])
  examSubject            ExamSubject          @relation(fields: [examSubjectId], references: [id])
  examSubjectPartition   ExamSubjectPartition @relation(fields: [examSubjectPartitionId], references: [id])
  student                Student              @relation(fields: [studentId], references: [id])
  Subject                Subject?             @relation(fields: [subjectId], references: [id])
  user                   User                 @relation(fields: [userId], references: [id])

  @@unique([studentId, examSubjectId, examSubjectPartitionId])
}

model Session {
  id             String   @id @default(uuid()) @map("_id") @db.Uuid
  sessionToken   String   @unique
  userId         String   @db.Uuid
  expires        DateTime
  currentBatchId String?  @db.Uuid
  currentBatch   Batch?   @relation(fields: [currentBatchId], references: [id])
  user           User     @relation(fields: [userId], references: [id])
}

model User {
  id                    String                 @id @default(uuid()) @map("_id") @db.Uuid
  name                  String?
  email                 String                 @unique
  emailVerified         DateTime?
  username              String?                @unique
  password              String
  phoneNumber           String
  role                  UserRole               @default(User)
  image                 String?
  accounts              Account[]
  createdAdmissionForms AdmissionForm[]
  createdBranches       Branch[]
  CoursePurchaseRecord  CoursePurchaseRecord[]
  Mark                  Mark[]
  createdOrganizations  Organization[]
  PaymentHistory        PaymentHistory[]
  sessions              Session[]
  staff                 Staff?
  student               Student?
  userOrganizations     UserOrganization[]
}

model Branch {
  id                         String                       @id @default(uuid()) @map("_id") @db.Uuid
  name                       String
  address                    String
  organizationId             String                       @db.Uuid
  isActivated                Boolean                      @default(false)
  createdAt                  DateTime?                    @default(now())
  updatedAt                  DateTime?                    @default(now())
  createdById                String                       @db.Uuid
  assessmentFormat           AssessmentFormat[]
  Batch                      Batch[]
  createdBy                  User                         @relation(fields: [createdById], references: [id])
  organization               Organization                 @relation(fields: [organizationId], references: [id])
  class                      Class[]
  CourseBatch                CourseBatch[]
  CourseCategory             CourseCategory[]
  CoursePurchaseRecord       CoursePurchaseRecord[]
  department                 Department[]
  Exam                       Exam[]
  examType                   ExamType[]
  forms                      Form[]
  grade                      Grade[]
  group                      Group[]
  InstituteCourse            InstituteCourse[]
  InstituteCourseChapter     InstituteCourseChapter[]
  InstituteCourseChapterItem InstituteCourseChapterItem[]
  InstituteCourseModule      InstituteCourseModule[]
  medium                     Medium[]
  natureOfPosting            NatureOfPosting[]
  regulation                 Regulation[]
  Role                       Role[]
  staff                      Staff[]
  Student                    Student[]
  Subject                    Subject[]
  SsbjectMaster              SubjectMaster[]
  term                       Term[]
  users                      UserOrganization[]
  subjectType                subjectType[]
  ClassLevelIncharge         ClassLevelIncharge[]
}

model Organization {
  id                   String                 @id @default(uuid()) @map("_id") @db.Uuid
  name                 String
  institute            String
  description          String?
  image                String?
  isActivated          Boolean                @default(false)
  createdAt            DateTime?              @default(now())
  updatedAt            DateTime?              @default(now())
  createdById          String                 @db.Uuid
  branches             Branch[]
  CoursePurchaseRecord CoursePurchaseRecord[]
  forms                Form[]
  InstituteCourse      InstituteCourse[]
  createdBy            User                   @relation(fields: [createdById], references: [id])
  periods              Periods[]
  Role                 Role[]
  staff                Staff[]
  Student              Student[]
  users                UserOrganization[]
  ClassLevelIncharge   ClassLevelIncharge[]
}

model UserOrganization {
  id             String       @id @default(uuid()) @map("_id") @db.Uuid
  userId         String       @db.Uuid
  organizationId String       @db.Uuid
  branchId       String?      @db.Uuid
  roleId         String?      @db.Uuid
  role           Role?        @relation(fields: [roleId], references: [id])
  branch         Branch?      @relation(fields: [branchId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])
}

model Role {
  id               String             @id @default(uuid()) @map("_id") @db.Uuid
  name             String
  organizationId   String             @db.Uuid
  branchId         String?            @db.Uuid
  moduleAccess     ModuleAccess[]
  branch           Branch?            @relation(fields: [branchId], references: [id])
  organization     Organization       @relation(fields: [organizationId], references: [id])
  UserOrganization UserOrganization[]
}

model ModuleAccess {
  id     String  @id @default(uuid()) @map("_id") @db.Uuid
  roleId String  @db.Uuid
  module String
  create Boolean @default(false)
  read   Boolean @default(false)
  update Boolean @default(false)
  delete Boolean @default(false)
  role   Role    @relation(fields: [roleId], references: [id])
}

model AdmissionForm {
  id          String          @id @default(uuid()) @map("_id") @db.Uuid
  studentId   String          @db.Uuid
  createdAt   DateTime?       @default(now())
  updatedAt   DateTime?       @default(now())
  createdById String          @db.Uuid
  status      AdmissionStatus
  formId      String?         @db.Uuid
  createdBy   User            @relation(fields: [createdById], references: [id])
  form        Form?           @relation(fields: [formId], references: [id])
  student     Student         @relation(fields: [studentId], references: [id])
}

model EnquiryForm {
  id                    String  @id @default(uuid()) @map("_id") @db.Uuid
  name                  String
  date                  String
  emailId               String
  contactNumber         String
  dob                   String
  gender                String
  age                   String
  maritalStatus         String
  fatherName            String
  fatherOccupation      String
  motherName            String
  motherOccupation      String
  guardianName          String
  guardianOccupation    String
  addressLine1          String
  addressLine2          String
  nationality           String
  state                 String
  district              String
  postalCode            String
  schoolName10th        String
  obtainedMark10th      String
  yearOfPassing10th     String
  mediumOfEducation10th String
  schoolName12th        String
  obtainedMark12th      String
  yearOfPassing12th     String
  mediumOfEducation12th String
  formId                String? @db.Uuid
  form                  Form?   @relation(fields: [formId], references: [id])
}

model Department {
  id             String    @id @default(uuid()) @map("_id") @db.Uuid
  departmentName String
  noOfYears      String
  departmentCode String
  isActive       Boolean
  description    String
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  branchId       String?   @db.Uuid
  course         Course[]
  branch         Branch?   @relation(fields: [branchId], references: [id])
}

model Regulation {
  id             String    @id @default(uuid()) @map("_id") @db.Uuid
  regulationName String
  announcedYear  String
  endYear        String?
  isActive       Boolean
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  branchId       String?   @db.Uuid
  Class          Class[]
  branch         Branch?   @relation(fields: [branchId], references: [id])
  subject        Subject[]
}

model Course {
  id           String      @id @default(uuid()) @map("_id") @db.Uuid
  courseName   String
  isActive     Boolean
  description  String
  isDeleted    Boolean     @default(false)
  deletedAt    DateTime?
  departmentId String?     @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id])
}

model InstituteCourse {
  id                       String                     @id @default(uuid()) @map("_id") @db.Uuid
  courseName               String
  description              String?
  tagLine                  String?
  languageId               String                     @db.Uuid
  price                    String
  discountPrice            String
  order                    Int                        @default(1)
  isActive                 Boolean                    @default(false)
  isDeleted                Boolean                    @default(false)
  deletedAt                DateTime?
  branchId                 String?                    @db.Uuid
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @default(now())
  organizationId           String?                    @db.Uuid
  coverImage               String?
  courseType               String                     @default("Recorded")
  status                   String                     @default("Draft")
  CourseBatch              CourseBatch[]
  CoursePurchaseRecord     CoursePurchaseRecord[]
  branch                   Branch?                    @relation(fields: [branchId], references: [id])
  language                 Language                   @relation(fields: [languageId], references: [id])
  organization             Organization?              @relation(fields: [organizationId], references: [id])
  InstituteCourseFAQ       InstituteCourseFAQ[]
  InstituteCourseHighlight InstituteCourseHighlight[]
  InstituteCourseModule    InstituteCourseModule[]
  InstituteCourseOutcome   InstituteCourseOutcome[]
  CourseCategory           CourseCategory[]           @relation("CourseCategories")
}

model InstituteCourseHighlight {
  id                String          @id @default(uuid()) @map("_id") @db.Uuid
  keyHighlight      String
  description       String?
  instituteCourseId String          @db.Uuid
  instituteCourse   InstituteCourse @relation(fields: [instituteCourseId], references: [id])
}

model InstituteCourseOutcome {
  id                String          @id @default(uuid()) @map("_id") @db.Uuid
  title             String
  description       String?
  icon              String?
  instituteCourseId String          @db.Uuid
  instituteCourse   InstituteCourse @relation(fields: [instituteCourseId], references: [id])
}

model InstituteCourseFAQ {
  id                String          @id @default(uuid()) @map("_id") @db.Uuid
  question          String
  answer            String
  instituteCourseId String          @db.Uuid
  instituteCourse   InstituteCourse @relation(fields: [instituteCourseId], references: [id])
}

model CourseBatch {
  id                   String                 @id @default(uuid()) @map("_id") @db.Uuid
  courseId             String                 @db.Uuid
  startDate            DateTime
  type                 String
  totalSeats           Int                    @default(0)
  totalHours           Int
  hoursPerDay          Int
  sessionDays          Json
  status               String                 @default("Draft")
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  deletedAt            DateTime?
  branchId             String                 @db.Uuid
  branch               Branch                 @relation(fields: [branchId], references: [id])
  course               InstituteCourse        @relation(fields: [courseId], references: [id])
  CoursePurchaseRecord CoursePurchaseRecord[]
  RecordedContent      RecordedBatchContent[]
}

model RecordedBatchContent {
  id           String                     @id @default(uuid()) @map("_id") @db.Uuid
  courseItemId String                     @db.Uuid
  videoUrl     String
  batchId      String                     @db.Uuid
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  deletedAt    DateTime?
  batch        CourseBatch                @relation(fields: [batchId], references: [id])
  courseItem   InstituteCourseChapterItem @relation(fields: [courseItemId], references: [id])
}

model CourseCategory {
  id                    String            @id @default(uuid()) @map("_id") @db.Uuid
  name                  String
  icon                  String?
  courseCategoryId      String?           @db.Uuid
  isActive              Boolean           @default(false)
  branchId              String?           @db.Uuid
  createdAt             DateTime?         @default(now())
  createdById           String?           @db.Uuid
  deletedAt             DateTime?
  updatedAt             DateTime?         @default(now())
  branch                Branch?           @relation(fields: [branchId], references: [id])
  parentCourseCategory  CourseCategory?   @relation("CourseCategoryChild", fields: [courseCategoryId], references: [id])
  childCourseCategories CourseCategory[]  @relation("CourseCategoryChild")
  InstituteCourse       InstituteCourse[] @relation("CourseCategories")
}

model InstituteCourseModule {
  id                String                   @id @default(uuid()) @map("_id") @db.Uuid
  name              String
  icon              String?
  description       String?
  isActive          Boolean                  @default(false)
  instituteCourseId String                   @db.Uuid
  createdAt         DateTime?                @default(now())
  updatedAt         DateTime?                @default(now())
  deletedAt         DateTime?
  createdById       String                   @db.Uuid
  branchId          String?                  @db.Uuid
  branch            Branch?                  @relation(fields: [branchId], references: [id])
  instituteCourse   InstituteCourse          @relation(fields: [instituteCourseId], references: [id])
  chapters          InstituteCourseChapter[] @relation("InstituteCourseChapterModule")
}

model InstituteCourseChapter {
  id           String                       @id @default(uuid()) @map("_id") @db.Uuid
  name         String
  icon         String?
  description  String?
  isActive     Boolean                      @default(false)
  createdAt    DateTime?                    @default(now())
  updatedAt    DateTime?                    @default(now())
  deletedAt    DateTime?
  createdById  String                       @db.Uuid
  branchId     String?                      @db.Uuid
  branch       Branch?                      @relation(fields: [branchId], references: [id])
  chapterItems InstituteCourseChapterItem[]
  modules      InstituteCourseModule[]      @relation("InstituteCourseChapterModule")
}

model InstituteCourseChapterItem {
  id                     String                   @id @default(uuid()) @map("_id") @db.Uuid
  name                   String
  icon                   String?
  description            String?
  languageId             String?                  @db.Uuid
  createdAt              DateTime?                @default(now())
  updatedAt              DateTime?                @default(now())
  deletedAt              DateTime?
  createdById            String                   @db.Uuid
  branchId               String?                  @db.Uuid
  chapterId              String                   @db.Uuid
  imageUrl               String?
  itemType               String                   @default("text")
  pdfUrl                 String?
  videoUrl               String?
  vimeoUrl               String?
  youtubeUrl             String?
  textContent            Json?
  branch                 Branch?                  @relation(fields: [branchId], references: [id])
  chapter                InstituteCourseChapter   @relation(fields: [chapterId], references: [id])
  language               Language?                @relation(fields: [languageId], references: [id])
  QuizChapterItemMapping QuizChapterItemMapping[]
  RecordedBatchContent   RecordedBatchContent[]
}

model Quiz {
  id                     String                   @id @default(uuid()) @map("_id") @db.Uuid
  name                   String
  instruction            String?
  description            String?
  isActive               Boolean                  @default(false)
  createdAt              DateTime?                @default(now())
  updatedAt              DateTime?                @default(now())
  deletedAt              DateTime?
  QuizChapterItemMapping QuizChapterItemMapping[]
}

model QuizChapterItemMapping {
  chapterItemId String                     @db.Uuid
  quizId        String                     @db.Uuid
  chapterItem   InstituteCourseChapterItem @relation(fields: [chapterItemId], references: [id])
  quiz          Quiz                       @relation(fields: [quizId], references: [id])

  @@unique([chapterItemId, quizId])
}

model QuizQuestion {
  id             String        @id @default(uuid()) @map("_id") @db.Uuid
  question       String
  explanation    String?
  maxTime        Int?
  minTime        Int?
  points         Int?
  negativePoints Int?
  isActive       Boolean       @default(false)
  createdAt      DateTime?     @default(now())
  updatedAt      DateTime?     @default(now())
  deletedAt      DateTime?
  QuizOptions    QuizOptions[]
}

model QuizOptions {
  id             String       @id @default(uuid()) @map("_id") @db.Uuid
  option         String
  isCorrect      Boolean      @default(false)
  explanation    String?
  quizQuestionId String       @db.Uuid
  quizQuestion   QuizQuestion @relation(fields: [quizQuestionId], references: [id])
}

model CoursePurchaseRecord {
  id              String           @id @default(uuid()) @map("_id") @db.Uuid
  courseId        String           @db.Uuid
  userId          String           @db.Uuid
  studentId       String?          @db.Uuid
  paymentType     String           @default("FullPayment")
  actualAmount    Float?           @default(0)
  discountAmount  Float?           @default(0)
  isPaid          Boolean          @default(false)
  paidFullPayment Boolean          @default(false)
  createdAt       DateTime?        @default(now())
  updatedAt       DateTime?        @default(now())
  organizationId  String           @db.Uuid
  courseBatchId   String?          @db.Uuid
  branchId        String           @db.Uuid
  branch          Branch           @relation(fields: [branchId], references: [id])
  courseBatch     CourseBatch?     @relation(fields: [courseBatchId], references: [id])
  course          InstituteCourse  @relation(fields: [courseId], references: [id])
  organization    Organization     @relation(fields: [organizationId], references: [id])
  student         Student?         @relation(fields: [studentId], references: [id])
  user            User             @relation(fields: [userId], references: [id])
  PaymentHistory  PaymentHistory[]
}

model PaymentHistory {
  id               String               @id @default(uuid()) @map("_id") @db.Uuid
  referenceId      String
  coursePurchaseId String               @db.Uuid
  paymentId        String?              @db.Uuid
  paymentMethod    String               @default("Online")
  amount           Float?               @default(0)
  paymentDate      DateTime             @default(now())
  createdById      String               @db.Uuid
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @default(now())
  coursePurchase   CoursePurchaseRecord @relation(fields: [coursePurchaseId], references: [id])
  createdBy        User                 @relation(fields: [createdById], references: [id])
  payment          Payment?             @relation(fields: [paymentId], references: [id])
}

model Form {
  id             String          @id @default(uuid()) @map("_id") @db.Uuid
  createdAt      DateTime?       @default(now())
  updatedAt      DateTime?       @default(now())
  type           String
  json           Json
  isActive       Boolean         @default(false)
  organizationId String?         @db.Uuid
  branchId       String?         @db.Uuid
  AdmissionForm  AdmissionForm[]
  EnquiryForm    EnquiryForm[]
  branch         Branch?         @relation(fields: [branchId], references: [id])
  organization   Organization?   @relation(fields: [organizationId], references: [id])
  Share          Share[]
  Student        Student[]
}

model Payment {
  id                  String                @id @default(uuid()) @map("_id") @db.Uuid
  transactionId       String
  receipt             String
  amount              String
  paymentDate         String
  paymentMethod       String                @default("Online")
  isActive            Boolean               @default(true)
  isPaid              Boolean               @default(false)
  isDeleted           Boolean               @default(false)
  deletedAt           DateTime?
  PaymentAssociations PaymentAssociations[]
  PaymentHistory      PaymentHistory[]
}

model PaymentAssociations {
  id                  String    @id @default(uuid()) @map("_id") @db.Uuid
  associationType     String
  associationEntityId String
  isDeleted           Boolean   @default(false)
  deletedAt           DateTime?
  paymentId           String?   @db.Uuid
  Payment             Payment?  @relation(fields: [paymentId], references: [id])
}

model Share {
  id             String    @id @default(uuid()) @map("_id") @db.Uuid
  isActive       Boolean   @default(true)
  acceptPayment  Boolean   @default(false)
  actualAmount   Float?
  discountAmount Float?
  activeFromDate DateTime?
  activeToDate   DateTime?
  formId         String    @db.Uuid
  form           Form      @relation(fields: [formId], references: [id])
}

model Student {
  id                     String                   @id @default(uuid()) @map("_id") @db.Uuid
  firstName              String
  middleName             String?
  lastName               String
  emailId                String
  phoneNumber            String
  aadharCardNumber       String?
  gender                 String                   @default("-")
  bloodGroup             String?
  dob                    String?
  fatherName             String?
  fatherOccupation       String?
  fatherPhoneNumber      String?
  guardiansOccupation    String?
  guardianName           String?
  guardianPhoneNumber    String?
  motherName             String?
  motherOccupation       String?
  motherPhoneNumber      String?
  nationality            String?
  religion               String?
  status                 StudentStatus
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @default(now())
  additionalAttributes   Json
  userId                 String                   @unique @db.Uuid
  branchId               String                   @db.Uuid
  batchId                String?                  @db.Uuid
  organizationId         String                   @db.Uuid
  sectionId              String?                  @db.Uuid
  isDeleted              Boolean                  @default(false)
  formId                 String?                  @db.Uuid
  fatherEmailId          String?
  guardianEmailId        String?
  motherEmailId          String?
  communityId            String?                  @db.Uuid
  motherTongueId         String?                  @db.Uuid
  admissionNumber        String?
  emisNumber             String                   @unique
  profileImage           String?
  AdmissionForm          AdmissionForm[]
  CoursePurchaseRecord   CoursePurchaseRecord[]
  Mark                   Mark[]
  batch                  Batch?                   @relation(fields: [batchId], references: [id])
  branch                 Branch                   @relation(fields: [branchId], references: [id])
  community              Community?               @relation(fields: [communityId], references: [id])
  form                   Form?                    @relation(fields: [formId], references: [id])
