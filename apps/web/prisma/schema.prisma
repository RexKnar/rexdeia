// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(uuid()) @map("_id") @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
}

model Exam {
  id         String      @id @default(uuid()) @map("_id") @db.Uuid
  name       String
  isActive   Boolean
  branch     Branch      @relation(fields: [branchId], references: [id])
  branchId   String      @db.Uuid
  examTypeId String      @db.Uuid
  examType   ExamType    @relation(fields: [examTypeId], references: [id])
  termId     String      @db.Uuid
  term       Term        @relation(fields: [termId], references: [id])
  batchId    String      @db.Uuid
  batch      Batch       @relation(fields: [batchId], references: [id])
  examGroup  ExamGroup[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @default(now())
  isDeleted  Boolean     @default(false)
}

model ExamType {
  id          String   @id @default(uuid()) @map("_id") @db.Uuid
  name        String
  isActive    Boolean
  frequencyId String
  branch      Branch   @relation(fields: [branchId], references: [id])
  branchId    String   @db.Uuid
  exam        Exam[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  isDeleted   Boolean  @default(false)
}

model Term {
  id        String   @id @default(uuid()) @map("_id") @db.Uuid
  name      String
  isActive  Boolean
  exam      Exam[]
  branch    Branch   @relation(fields: [branchId], references: [id])
  branchId  String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  isDeleted Boolean  @default(false)
}

model ExamGroup {
  id                   String                 @id @default(uuid()) @map("_id") @db.Uuid
  totalMarks           Int?
  examSubject          ExamSubject[]
  classId              String                 @db.Uuid
  class                Class                  @relation(fields: [classId], references: [id])
  sectionId            String                 @db.Uuid
  section              Section?               @relation(fields: [sectionId], references: [id])
  examId               String                 @db.Uuid
  exam                 Exam                   @relation(fields: [examId], references: [id])
  ExamSubjectPartition ExamSubjectPartition[]
}

model ExamSubject {
  id                   String                 @id @default(uuid()) @map("_id") @db.Uuid
  subjectId            String                 @db.Uuid
  subject              Subject                @relation(fields: [subjectId], references: [id])
  groupId              String                 @db.Uuid
  group                Group                  @relation(fields: [groupId], references: [id])
  totalMarks           Int                    @default(0)
  convertTo            Int                    @default(0)
  minMark              Int                    @default(0)
  examSubjectPartition ExamSubjectPartition[]
  examGroup            ExamGroup              @relation(fields: [examGroupId], references: [id])
  examGroupId          String                 @db.Uuid
  Mark                 Mark[]
}

model ExamSubjectPartition {
  id                 String           @id @default(uuid()) @map("_id") @db.Uuid
  subjectId          String           @db.Uuid
  subject            Subject          @relation(fields: [subjectId], references: [id])
  minMark            Int
  totalMarks         Int
  convertTo          Int
  dateToConduct      DateTime
  partitionName      String?
  examSubject        ExamSubject      @relation(fields: [examSubjectId], references: [id])
  examSubjectId      String           @db.Uuid
  assessmentFormat   AssessmentFormat @relation(fields: [assessmentFormatId], references: [id])
  assessmentFormatId String           @db.Uuid
  examGroup          ExamGroup        @relation(fields: [examGroupId], references: [id])
  examGroupId        String           @db.Uuid
  Mark               Mark[]
}

model Mark {
  id                     String               @id @default(uuid()) @map("_id") @db.Uuid
  mark                   Int?
  attandance             Int?
  studentId              String               @db.Uuid
  student                Student              @relation(fields: [studentId], references: [id])
  staffId                String               @db.Uuid
  staff                  Staff                @relation(fields: [staffId], references: [id])
  examSubject            ExamSubject          @relation(fields: [examSubjectId], references: [id])
  examSubjectId          String               @db.Uuid
  examSubjectPartition   ExamSubjectPartition @relation(fields: [examSubjectPartitionId], references: [id])
  examSubjectPartitionId String               @db.Uuid
  Subject                Subject?             @relation(fields: [subjectId], references: [id])
  subjectId              String?              @db.Uuid
  SubjectMasterId        String?              @db.Uuid
  SubjectMaster          SubjectMaster?       @relation(fields: [SubjectMasterId], references: [id])
  AssessmentFormat       AssessmentFormat?    @relation(fields: [assessmentFormatId], references: [id])
  assessmentFormatId     String?              @db.Uuid

  @@unique([studentId, examSubjectId, examSubjectPartitionId])
}

model Session {
  id           String   @id @default(uuid()) @map("_id") @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id])
}

model User {
  id            String    @id @default(uuid()) @map("_id") @db.Uuid
  name          String?
  email         String    @unique
  emailVerified DateTime?
  username      String?   @unique
  password      String
  phoneNumber   String
  role          UserRole  @default(User)

  image                 String?
  staff                 Staff?
  student               Student?
  accounts              Account[]
  sessions              Session[]
  userOrganizations     UserOrganization[]
  createdBranches       Branch[]
  createdOrganizations  Organization[]
  createdAdmissionForms AdmissionForm[]
}

enum UserRole {
  Admin
  TeachingStaff
  NonTeachingStaff
  Student
  User
}

model Branch {
  id               String             @id @default(uuid()) @map("_id") @db.Uuid
  name             String
  address          String
  organization     Organization       @relation(fields: [organizationId], references: [id])
  organizationId   String             @db.Uuid
  users            UserOrganization[]
  forms            Form[]
  department       Department[]
  regulation       Regulation[]
  isActivated      Boolean            @default(false)
  createdAt        DateTime?          @default(now())
  updatedAt        DateTime?          @default(now())
  createdBy        User               @relation(fields: [createdById], references: [id])
  createdById      String             @db.Uuid
  Batch            Batch[]
  Student          Student[]
  class            Class[]
  staff            Staff[]
  group            Group[]
  medium           Medium[]
  subjectType      subjectType[]
  assessmentFormat AssessmentFormat[]
  Subject          Subject[]
  grade            Grade[]
  Exam             Exam[]
  examType         ExamType[]
  term             Term[]
  SsbjectMaster    SubjectMaster[]
  natureOfPosting  NatureOfPosting[]
}

model Organization {
  id          String             @id @default(uuid()) @map("_id") @db.Uuid
  name        String
  institute   String
  description String?
  image       String?
  users       UserOrganization[]
  branches    Branch[]
  forms       Form[]
  isActivated Boolean            @default(false)
  createdAt   DateTime?          @default(now())
  updatedAt   DateTime?          @default(now())
  createdBy   User               @relation(fields: [createdById], references: [id])
  createdById String             @db.Uuid
  Student     Student[]
  staff       Staff[]
}

model UserOrganization {
  id             String       @id @default(uuid()) @map("_id") @db.Uuid
  user           User         @relation(fields: [userId], references: [id])
  userId         String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String       @db.Uuid
  branch         Branch?      @relation(fields: [branchId], references: [id])
  branchId       String?      @db.Uuid
}

model AdmissionForm {
  id          String          @id @default(uuid()) @map("_id") @db.Uuid
  student     Student         @relation(fields: [studentId], references: [id])
  studentId   String          @db.Uuid
  createdAt   DateTime?       @default(now())
  updatedAt   DateTime?       @default(now())
  createdBy   User            @relation(fields: [createdById], references: [id])
  createdById String          @db.Uuid
  status      AdmissionStatus
  form        Form?           @relation(fields: [formId], references: [id])
  formId      String?         @db.Uuid
}

model EnquiryForm {
  id                    String  @id @default(uuid()) @map("_id") @db.Uuid
  name                  String
  date                  String
  emailId               String
  contactNumber         String
  dob                   String
  gender                String
  age                   String
  maritalStatus         String
  fatherName            String
  fatherOccupation      String
  motherName            String
  motherOccupation      String
  guardianName          String
  guardianOccupation    String
  addressLine1          String
  addressLine2          String
  nationality           String
  state                 String
  district              String
  postalCode            String
  schoolName10th        String
  obtainedMark10th      String
  yearOfPassing10th     String
  mediumOfEducation10th String
  schoolName12th        String
  obtainedMark12th      String
  yearOfPassing12th     String
  mediumOfEducation12th String
  form                  Form?   @relation(fields: [formId], references: [id])
  formId                String? @db.Uuid
}

model Department {
  id             String    @id @default(uuid()) @map("_id") @db.Uuid
  departmentName String
  noOfYears      String
  departmentCode String
  isActive       Boolean
  description    String
  course         Course[]
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  branch         Branch?   @relation(fields: [branchId], references: [id])
  branchId       String?   @db.Uuid
}

model Regulation {
  id             String    @id @default(uuid()) @map("_id") @db.Uuid
  regulationName String
  announcedYear  String
  endYear        String?
  isActive       Boolean
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  branch         Branch?   @relation(fields: [branchId], references: [id])
  branchId       String?   @db.Uuid
  Class          Class[]
  subject        Subject[]
}

model Course {
  id           String      @id @default(uuid()) @map("_id") @db.Uuid
  courseName   String
  isActive     Boolean
  description  String
  isDeleted    Boolean     @default(false)
  deletedAt    DateTime?
  department   Department? @relation(fields: [departmentId], references: [id])
  departmentId String?     @db.Uuid
}

model Form {
  id             String          @id @default(uuid()) @map("_id") @db.Uuid
  createdAt      DateTime?       @default(now())
  updatedAt      DateTime?       @default(now())
  type           String
  json           Json
  isActive       Boolean         @default(false)
  organization   Organization?   @relation(fields: [organizationId], references: [id])
  organizationId String?         @db.Uuid
  branch         Branch?         @relation(fields: [branchId], references: [id])
  branchId       String?         @db.Uuid
  EnquiryForm    EnquiryForm[]
  Share          Share[]
  Student        Student[]
  AdmissionForm  AdmissionForm[]
}

model Payment {
  id                  String                @id @default(uuid()) @map("_id") @db.Uuid
  transactionId       String
  receipt             String
  amount              String
  paymentDate         String
  paymentMethod       String                @default("Online")
  isActive            Boolean               @default(true)
  isPaid              Boolean               @default(false)
  isDeleted           Boolean               @default(false)
  deletedAt           DateTime?
  PaymentAssociations PaymentAssociations[]
}

model PaymentAssociations {
  id                  String    @id @default(uuid()) @map("_id") @db.Uuid
  associationType     String
  associationEntityId String
  isDeleted           Boolean   @default(false)
  deletedAt           DateTime?
  Payment             Payment?  @relation(fields: [paymentId], references: [id])
  paymentId           String?   @db.Uuid
}

model Share {
  id             String    @id @default(uuid()) @map("_id") @db.Uuid
  isActive       Boolean   @default(true)
  acceptPayment  Boolean   @default(false)
  actualAmount   Float?
  discountAmount Float?
  activeFromDate DateTime?
  activeToDate   DateTime?
  form           Form      @relation(fields: [formId], references: [id])
  formId         String    @db.Uuid
}

model Student {
  id                   String        @id @default(uuid()) @map("_id") @db.Uuid
  firstName            String
  middleName           String?
  lastName             String
  emailId              String
  phoneNumber          String
  aadharCardNumber     String
  gender               String
  bloodGroup           String?
  dob                  String
  fatherName           String?
  fatherOccupation     String?
  fatherPhoneNumber    String?
  fatherEmailId        String?
  guardiansOccupation  String?
  guardianName         String?
  guardianPhoneNumber  String?
  guardianEmailId      String?
  motherName           String?
  motherOccupation     String?
  motherPhoneNumber    String?
  motherEmailId        String?
  motherTongueId       String?       @db.Uuid
  motherTongue         Language?     @relation(fields: [motherTongueId], references: [id])
  nationality          String?
  religion             String?
  status               StudentStatus
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @default(now())
  additionalAttributes Json

  userId                 String                   @unique @db.Uuid
  user                   User                     @relation(fields: [userId], references: [id])
  branch                 Branch                   @relation(fields: [branchId], references: [id])
  branchId               String                   @db.Uuid
  batch                  Batch?                   @relation(fields: [batchId], references: [id])
  batchId                String?                  @db.Uuid
  organization           Organization             @relation(fields: [organizationId], references: [id])
  organizationId         String                   @db.Uuid
  form                   Form?                    @relation(fields: [formId], references: [id])
  AdmissionForm          AdmissionForm[]
  formId                 String?                  @db.Uuid
  studentMapping         StudentMapping[]
  sectionId              String?                  @db.Uuid
  section                Section?                 @relation(fields: [sectionId], references: [id])
  isDeleted              Boolean                  @default(false)
  Mark                   Mark[]
  communityId            String?                  @db.Uuid
  community              Community?               @relation(fields: [communityId], references: [id])
  StudentElectiveSubject StudentElectiveSubject[]
}

model StudentMapping {
  id        String   @id @default(uuid()) @map("_id") @db.Uuid
  studentId String   @db.Uuid
  student   Student  @relation(fields: [studentId], references: [id])
  classId   String   @db.Uuid
  class     Class    @relation(fields: [classId], references: [id])
  sectionId String?  @db.Uuid
  section   Section? @relation(fields: [sectionId], references: [id])
  groupId   String   @db.Uuid
  group     Group    @relation(fields: [groupId], references: [id])
  mediumId  String?  @db.Uuid
  medium    Medium?  @relation(fields: [mediumId], references: [id])
  batchId   String?  @db.Uuid
  batch     Batch?   @relation(fields: [batchId], references: [id])
}

model Staff {
  id                           String                    @id @default(uuid()) @map("_id") @db.Uuid
  image                        String?
  aadharCardNumber             String?
  firstName                    String                    @default("")
  middleName                   String?                   @default("")
  lastName                     String                    @default("")
  dateOfBirth                  DateTime                  @default(now())
  gender                       String                    @default("")
  mobile                       String                    @default("")
  email                        String                    @default("")
  age                          String?
  bloodGroup                   String?
  religion                     String?
  communityId                  String?                   @db.Uuid
  community                    Community?                @relation(fields: [communityId], references: [id])
  nationality                  String?
  motherTongueId               String?                   @db.Uuid
  motherTongue                 Language?                 @relation(fields: [motherTongueId], references: [id])
  enrollmentNumber             String?
  specialCategory              String?
  differentlyAbled             Boolean                   @default(false)
  epfNumber                    String?
  fatherName                   String?
  fatherOccupation             String?
  motherName                   String?
  motherOccupation             String?
  spouseName                   String?
  spouseOccupation             String?
  currentAddressLine1          String?
  currentAddressLine2          String?
  currentCity                  String?
  currentState                 String?
  currentCountry               String?
  currentPincode               String?
  permanentAddress1            String?
  permanentAddress2            String?
  permanentCity                String?
  permanentState               String?
  permanentPincode             String?
  permanentCountry             String?
  birthCertificate             String?
  communityCertificate         String?
  childImmunicationCertificate String?
  medicalCertificate           String?
  covidVaccinationCertificate  String?
  characterCertificate         String?
  fathersPhoto                 String?
  mothersPhoto                 String?
  spousePhoto                  String?
  incomeCertificate            String?
  transferCertificate          String?
  sslcMarksCard                String?
  pucMarksCard                 String?
  degreeMarksCard              String?
  pgMarksCard                  String?
  natureOfPostingId            String?                   @db.Uuid
  natureOfPosting              NatureOfPosting?          @relation(fields: [natureOfPostingId], references: [id])
  otherCertificate             String?
  dateOfDetainment             DateTime?
  dateOfRetirement             DateTime?
  dateOfRegularization         DateTime?
  employmentTypeId             String?                   @db.Uuid
  employmentType               EmploymentType?           @relation(fields: [employmentTypeId], references: [id])
  employeeId                   String?
  enrollmentId                 String?
  cps                          String?
  tpf                          String?
  staffCategoryId              String?                   @db.Uuid
  staffCategory                StaffCategory?            @relation(fields: [staffCategoryId], references: [id])
  subjectHandling              String?
  collegeName                  String?
  passOutYear                  DateTime?
  marksObtained                String?
  designationId                String?                   @db.Uuid
  designation                  Designation?              @relation(fields: [designationId], references: [id])
  accountHolderName            String?
  accountNumber                String?
  branchName                   String?
  IFSC_Code                    String?
  dateOfJoining                DateTime                  @default(now())
  status                       StaffStatus               @default(Active)
  userId                       String                    @unique @db.Uuid
  user                         User                      @relation(fields: [userId], references: [id])
  createdAt                    DateTime?                 @default(now())
  updatedAt                    DateTime?                 @default(now())
  Organization                 Organization?             @relation(fields: [organizationId], references: [id])
  organizationId               String?                   @db.Uuid
  Branch                       Branch?                   @relation(fields: [branchId], references: [id])
  branchId                     String?                   @db.Uuid
  sections                     Section[]
  sectionIds                   String[]                  @db.Uuid
  staffSections                StaffSection[]
  academicSubjectForStaff      AcademicSubjectForStaff[]
  Mark                         Mark[]
}

model Batch {
  id                      String                    @id @default(uuid()) @map("_id") @db.Uuid
  name                    String
  description             String?
  startYear               String
  endYear                 String
  isActive                Boolean
  currentAcademicYear     Boolean                   @default(false)
  isDeleted               Boolean                   @default(false)
  class                   Class[]
  branch                  Branch                    @relation(fields: [branchId], references: [id])
  branchId                String                    @db.Uuid
  students                Student[]
  AcademicSubjectForStaff AcademicSubjectForStaff[]
  createdAt               DateTime?                 @default(now())
  updatedAt               DateTime?                 @default(now())
  exams                   Exam[]
  StudentMapping          StudentMapping[]
  StudentElectiveSubject  StudentElectiveSubject[]
}

model Class {
  id             String           @id @default(uuid()) @map("_id") @db.Uuid
  name           String
  description    String?
  isActive       Boolean
  isDeleted      Boolean          @default(false)
  Section        Section[]
  batch          Batch?           @relation(fields: [batchId], references: [id])
  batchId        String?          @db.Uuid
  branch         Branch           @relation(fields: [branchId], references: [id])
  branchId       String           @db.Uuid
  regulation     Regulation?      @relation(fields: [regulationId], references: [id])
  regulationId   String?          @db.Uuid
  studentmapping StudentMapping[]
  createdAt      DateTime?        @default(now())
  updatedAt      DateTime?        @default(now())
  subjects       Subject[]
  subjectToGroup SubjectToGroup[]
  ExamGroup      ExamGroup[]
}

model StaffSection {
  sectionId String    @db.Uuid
  staffId   String    @db.Uuid
  section   Section   @relation(fields: [sectionId], references: [id])
  staff     Staff     @relation(fields: [staffId], references: [id])
  createdAt DateTime? @default(now())
  updatedAt DateTime? @default(now())

  @@id([sectionId, staffId])
}

model AcademicSubjectForStaff {
  id             String    @id @default(uuid()) @map("_id") @db.Uuid
  staffId        String    @db.Uuid
  staff          Staff     @relation(fields: [staffId], references: [id])
  subjectId      String?   @db.Uuid
  subject        Subject?  @relation(fields: [subjectId], references: [id])
  academicYearId String    @db.Uuid
  academicYear   Batch     @relation(fields: [academicYearId], references: [id])
  sectionId      String    @db.Uuid
  section        Section   @relation(fields: [sectionId], references: [id])
  isIncharge     Boolean   @default(false)
  deletedAt      DateTime? @db.Timestamp

  @@unique([academicYearId, staffId, sectionId, subjectId, deletedAt])
}

model Section {
  id                      String                    @id @default(uuid()) @map("_id") @db.Uuid
  name                    String
  description             String?
  faculty                 String?
  isActive                Boolean
  medium                  Medium                    @relation(fields: [mediumId], references: [id])
  mediumId                String                    @db.Uuid
  class                   Class                     @relation(fields: [classId], references: [id])
  staff                   Staff?                    @relation(fields: [staffId], references: [id])
  students                Student[]
  classId                 String                    @db.Uuid
  createdAt               DateTime?                 @default(now())
  updatedAt               DateTime?                 @default(now())
  isDeleted               Boolean                   @default(false)
  Subject                 Subject?                  @relation(fields: [subjectId], references: [id])
  subjectId               String?                   @db.Uuid
  staffSections           StaffSection[]
  staffId                 String?                   @db.Uuid
  academicSubjectForStaff AcademicSubjectForStaff[]
  studentMapping          StudentMapping[]
  sectionToGroups         SectionToGroups[]
  ExamGroup               ExamGroup[]
}

model SectionToGroups {
  sectionId String    @db.Uuid
  groupId   String    @db.Uuid
  section   Section   @relation(fields: [sectionId], references: [id])
  group     Group     @relation(fields: [groupId], references: [id])
  createdAt DateTime? @default(now())
  updatedAt DateTime? @default(now())

  @@id([sectionId, groupId])
}

model SubjectMaster {
  id                     String                   @id @default(uuid()) @map("_id") @db.Uuid
  name                   String
  isActive               Boolean
  subject                Subject[]
  branchId               String?                  @db.Uuid
  branch                 Branch?                  @relation(fields: [branchId], references: [id])
  isDeleted              Boolean                  @default(false)
  createdAt              DateTime?                @default(now())
  updatedAt              DateTime?                @default(now())
  StudentElectiveSubject StudentElectiveSubject[]
  Mark                   Mark[]
}

model Subject {
  id                        String                      @id @default(uuid()) @map("_id") @db.Uuid
  description               String?
  name                      String
  isActive                  Boolean
  elective                  Int
  createdAt                 DateTime?                   @default(now())
  updatedAt                 DateTime?                   @default(now())
  isDeleted                 Boolean                     @default(false)
  Section                   Section[]
  regulation                Regulation                  @relation(fields: [regulationId], references: [id])
  regulationId              String                      @db.Uuid
  sectionId                 String[]                    @db.Uuid
  ExamSubject               ExamSubject[]
  ExamSubjectPartition      ExamSubjectPartition[]
  branchId                  String?                     @db.Uuid
  branch                    Branch?                     @relation(fields: [branchId], references: [id])
  subjectMasterId           String                      @db.Uuid
  subjectMaster             SubjectMaster               @relation(fields: [subjectMasterId], references: [id])
  classId                   String                      @db.Uuid
  class                     Class                       @relation(fields: [classId], references: [id])
  subjectToAssessmentFormat SubjectToAssessmentFormat[]
  subjectToGroup            SubjectToGroup[]
  subjectToSubjectTypes     SubjectToSubjectType[]
  academicSubjectForStaff   AcademicSubjectForStaff[]
  marks                     Mark[]
  StudentElectiveSubject    StudentElectiveSubject[]
}

model StudentElectiveSubject {
  id              String        @id @default(uuid()) @map("_id") @db.Uuid
  studentId       String        @db.Uuid
  student         Student       @relation(fields: [studentId], references: [id])
  subjectMasterId String        @db.Uuid
  subjectMaster   SubjectMaster @relation(fields: [subjectMasterId], references: [id])
  subjectId       String        @db.Uuid
  subject         Subject       @relation(fields: [subjectId], references: [id])
  academicYearId  String        @db.Uuid
  academicYear    Batch         @relation(fields: [academicYearId], references: [id])
  deletedAt       DateTime?     @db.Timestamp

  @@unique([academicYearId, studentId, subjectId, deletedAt])
}

model AssessmentFormat {
  id                        String                      @id @default(uuid()) @map("_id") @db.Uuid
  name                      String
  isActive                  Boolean
  hasMarkEntry              Boolean?
  parentId                  String?                     @db.Uuid
  parentAssessmentFormat    AssessmentFormat?           @relation("ParentChild", fields: [parentId], references: [id])
  childAssessmentFormats    AssessmentFormat[]          @relation("ParentChild")
  branch                    Branch                      @relation(fields: [branchId], references: [id])
  branchId                  String                      @db.Uuid
  isDeleted                 Boolean                     @default(false)
  createdAt                 DateTime?                   @default(now())
  updatedAt                 DateTime?                   @default(now())
  subjectToAssessmentFormat SubjectToAssessmentFormat[]
  ExamSubjectPartition      ExamSubjectPartition[]
  Mark                      Mark[]
}

model SubjectToAssessmentFormat {
  assessmentFormatId String           @db.Uuid
  subjectId          String           @db.Uuid
  assessmentFormat   AssessmentFormat @relation(fields: [assessmentFormatId], references: [id])
  subject            Subject          @relation(fields: [subjectId], references: [id])
  createdAt          DateTime?        @default(now())
  updatedAt          DateTime?        @default(now())

  @@id([assessmentFormatId, subjectId])
}

model SubjectToGroup {
  subjectId String    @db.Uuid
  subject   Subject   @relation(fields: [subjectId], references: [id])
  groupId   String    @db.Uuid
  group     Group     @relation(fields: [groupId], references: [id])
  classId   String    @db.Uuid
  class     Class     @relation(fields: [classId], references: [id])
  createdAt DateTime? @default(now())
  updatedAt DateTime? @default(now())

  @@id([groupId, subjectId])
}

model SubjectToSubjectType {
  subjectId     String      @db.Uuid
  subject       Subject     @relation(fields: [subjectId], references: [id])
  subjectTypeId String      @db.Uuid
  subjectType   subjectType @relation(fields: [subjectTypeId], references: [id])
  createdAt     DateTime?   @default(now())
  updatedAt     DateTime?   @default(now())

  @@id([subjectTypeId, subjectId])
}

model Group {
  id              String            @id @default(uuid()) @map("_id") @db.Uuid
  name            String
  isActive        Boolean
  isDeleted       Boolean           @default(false)
  branch          Branch            @relation(fields: [branchId], references: [id])
  branchId        String            @db.Uuid
  createdAt       DateTime?         @default(now())
  updatedAt       DateTime?         @default(now())
  subjectToGroup  SubjectToGroup[]
  studentMapping  StudentMapping[]
  sectionToGroups SectionToGroups[]
  ExamSubject     ExamSubject[]
}

model Medium {
  id             String           @id @default(uuid()) @map("_id") @db.Uuid
  name           String
  isActive       Boolean
  section        Section[]
  isDeleted      Boolean          @default(false)
  branch         Branch           @relation(fields: [branchId], references: [id])
  studentMapping StudentMapping[]
  branchId       String           @db.Uuid
  createdAt      DateTime?        @default(now())
  updatedAt      DateTime?        @default(now())
}

model subjectType {
  id                    String                 @id @default(uuid()) @map("_id") @db.Uuid
  name                  String
  isActive              Boolean
  isDeleted             Boolean                @default(false)
  branch                Branch                 @relation(fields: [branchId], references: [id])
  branchId              String                 @db.Uuid
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @default(now())
  deletedAt             DateTime?
  subjectToSubjectTypes SubjectToSubjectType[]
}

model Grade {
  id          String        @id @default(uuid()) @map("_id") @db.Uuid
  name        String
  isActive    Boolean
  branch      Branch        @relation(fields: [branchId], references: [id])
  branchId    String        @db.Uuid
  createdAt   DateTime?     @default(now())
  updatedAt   DateTime?     @default(now())
  isDeleted   Boolean       @default(false)
  gradeScales GradeScales[]
}

model GradeScales {
  id         String    @id @default(uuid()) @map("_id") @db.Uuid
  startValue String
  endValue   String
  gradeName  String
  remark     String
  grade      Grade?    @relation(fields: [gradeId], references: [id])
  gradeId    String?   @db.Uuid
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @default(now())
  isDeleted  Boolean   @default(false)
}

model Community {
  id        String    @id @default(uuid()) @map("_id") @db.Uuid
  name      String
  isActive  Boolean
  createdAt DateTime? @default(now())
  updatedAt DateTime? @default(now())
  isDeleted Boolean   @default(false)
  staff     Staff[]
  student   Student[]
}

model Language {
  id        String    @id @default(uuid()) @map("_id") @db.Uuid
  name      String
  isActive  Boolean
  createdAt DateTime? @default(now())
  updatedAt DateTime? @default(now())
  isDeleted Boolean   @default(false)
  staff     Staff[]
  student   Student[]
}

model StaffCategory {
  id        String    @id @default(uuid()) @map("_id") @db.Uuid
  name      String
  isActive  Boolean
  createdAt DateTime? @default(now())
  updatedAt DateTime? @default(now())
  isDeleted Boolean   @default(false)
  staff     Staff[]
}

model EmploymentType {
  id        String    @id @default(uuid()) @map("_id") @db.Uuid
  name      String
  isActive  Boolean
  createdAt DateTime? @default(now())
  updatedAt DateTime? @default(now())
  isDeleted Boolean   @default(false)
  staff     Staff[]
}

model Designation {
  id        String    @id @default(uuid()) @map("_id") @db.Uuid
  name      String
  isActive  Boolean
  createdAt DateTime? @default(now())
  updatedAt DateTime? @default(now())
  isDeleted Boolean   @default(false)
  staff     Staff[]
}

model NatureOfPosting {
  id        String    @id @default(uuid()) @map("_id") @db.Uuid
  name      String
  isActive  Boolean
  createdAt DateTime? @default(now())
  updatedAt DateTime? @default(now())
  isDeleted Boolean   @default(false)
  staff     Staff[]
  branchId  String    @db.Uuid
  branch    Branch    @relation(fields: [branchId], references: [id])
}

model Test {
  id           String   @id @default(uuid()) @map("_id") @db.Uuid
  testType     TestType
  testNumber   Int
  studentMarks Json
  outOfMark    String
}

enum TestType {
  UnitTest
  TermTest
  ClassTest
}

enum StudentStatus {
  Pending
  Rejected
  Active
}

enum StaffStatus {
  Active
  InActive
  Resigned
  Suspended
  Fired
}

enum AdmissionStatus {
  Received
  UnderReview
  Waitlisted
  Accepted
  Rejected
  Deferred
  Withdrawn
  Enrolled
  Archived
  DirectStudentEntry
}
