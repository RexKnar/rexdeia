// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id])
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String    @unique
  emailVerified DateTime?
  username      String?   @unique
  password      String
  phoneNumber   String

  image               String?
  accounts            Account[]
  sessions            Session[]
  userOrganizations   UserOrganization[]
  CreatedBranch       Branch[]
  CreatedOrganization Organization[]
}

model Branch {
  id             String             @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  address        String
  organization   Organization       @relation(fields: [organizationId], references: [id])
  organizationId String             @db.ObjectId
  users          UserOrganization[]
  forms          Form[]
  isActivated    Boolean            @default(false)
  createdAt      DateTime?          @default(now())
  updatedAt      DateTime?          @default(now())
  createdBy      User               @relation(fields: [createdById], references: [id])
  createdById    String             @db.ObjectId
}

model Organization {
  id          String             @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  institute   String
  description String?
  image       String?
  users       UserOrganization[]
  branches    Branch[]
  forms       Form[]
  isActivated Boolean            @default(false)
  createdAt   DateTime?          @default(now())
  updatedAt   DateTime?          @default(now())
  createdBy   User               @relation(fields: [createdById], references: [id])
  createdById String             @db.ObjectId
}

model UserOrganization {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  user           User         @relation(fields: [userId], references: [id])
  userId         String       @db.ObjectId
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String       @db.ObjectId
  branch         Branch?      @relation(fields: [branchId], references: [id])
  branchId       String?      @db.ObjectId
}

model AdmissionForm {
  id                    String  @id @default(auto()) @map("_id") @db.ObjectId
  aadharCardNumber      String
  admissionMode         String
  admissionType         String
  annualIncome          String
  bloodGroup            String
  caste                 String
  dob                   String
  emailId               String
  fatherName            String
  fatherOccupation      String
  firstName             String
  firstLanguage         String
  gender                String
  guardiansOccupation   String
  guardianName          String
  guardianPhoneNumber   String
  lastName              String
  maritalStatus         String
  mediumOfEducation10th String
  mediumOfEducation12th String
  middleName            String
  mobileNumber          String
  motherName            String
  motherOccupation      String
  motherTongue          String
  nationality           String
  noOfSiblings          String
  obtainedMark10th      String
  obtainedMark12th      String
  community             String
  courseOption1         String
  courseOption2         String
  parentsSeparated      String
  permanentDistrict     String
  permanentPostalCode   String
  permanentState        String
  phoneNumber           String
  relationshipType      String
  religion              String
  residentialDistrict   String
  residentialPostalCode String
  residentialState      String
  scholarship           String
  schoolName10th        String
  schoolName12th        String
  siblingClass1         String
  siblingClass2         String
  siblingName1          String
  siblingName2          String
  siblingRelation1      String
  siblingRelation2      String
  yearOfPassing10th     String
  yearOfPassing12th     String
  residentialAddress    String
  permanentAddress      String
  form                  Form?   @relation(fields: [formId], references: [id])
  formId                String? @db.ObjectId
}

model EnquiryForm {
  id                    String  @id @default(auto()) @map("_id") @db.ObjectId
  name                  String
  date                  String
  emailId               String
  contactNumber         String
  dob                   String
  gender                String
  age                   String
  maritalStatus         String
  fatherName            String
  fatherOccupation      String
  motherName            String
  motherOccupation      String
  guardianName          String
  guardianOccupation    String
  addressLine1          String
  addressLine2          String
  nationality           String
  state                 String
  district              String
  postalCode            String
  schoolName10th        String
  obtainedMark10th      String
  yearOfPassing10th     String
  mediumOfEducation10th String
  schoolName12th        String
  obtainedMark12th      String
  yearOfPassing12th     String
  mediumOfEducation12th String
  form                  Form?   @relation(fields: [formId], references: [id])
  formId                String? @db.ObjectId
}

model Form {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  createdAt      DateTime?       @default(now())
  updatedAt      DateTime?       @default(now())
  type           String
  json           Json
  isActive       Boolean         @default(false)
  organization   Organization?   @relation(fields: [organizationId], references: [id])
  organizationId String?         @db.ObjectId
  branch         Branch?         @relation(fields: [branchId], references: [id])
  branchId       String?         @db.ObjectId
  EnquiryForm    EnquiryForm[]
  AdmissionForm  AdmissionForm[]
}
