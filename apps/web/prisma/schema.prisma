// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(uuid()) @map("_id") @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid()) @map("_id") @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id])
}

model User {
  id            String    @id @default(uuid()) @map("_id") @db.Uuid
  name          String?
  email         String    @unique
  emailVerified DateTime?
  username      String?   @unique
  password      String
  phoneNumber   String
  role          UserRole  @default(User)

  image                 String?
  staff                 Staff?
  student               Student?
  accounts              Account[]
  sessions              Session[]
  userOrganizations     UserOrganization[]
  createdBranches       Branch[]
  createdOrganizations  Organization[]
  createdAdmissionForms AdmissionForm[]
}

enum UserRole {
  Admin
  TeachingStaff
  NonTeachingStaff
  Student
  User
}

model Branch {
  id             String             @id @default(uuid()) @map("_id") @db.Uuid
  name           String
  address        String
  organization   Organization       @relation(fields: [organizationId], references: [id])
  organizationId String             @db.Uuid
  users          UserOrganization[]
  forms          Form[]
  department     Department[]
  regulation     Regulation[]
  isActivated    Boolean            @default(false)
  createdAt      DateTime?          @default(now())
  updatedAt      DateTime?          @default(now())
  createdBy      User               @relation(fields: [createdById], references: [id])
  createdById    String             @db.Uuid
  Batch          Batch[]
  Student        Student[]
  class          Class[]
  staff          Staff[]
  group          Group[]
  medium         Medium[]
  subjectType    SubjectType[]
  subjectFormat  SubjectFormat[]
}

model Organization {
  id          String             @id @default(uuid()) @map("_id") @db.Uuid
  name        String
  institute   String
  description String?
  image       String?
  users       UserOrganization[]
  branches    Branch[]
  forms       Form[]
  isActivated Boolean            @default(false)
  createdAt   DateTime?          @default(now())
  updatedAt   DateTime?          @default(now())
  createdBy   User               @relation(fields: [createdById], references: [id])
  createdById String             @db.Uuid
  Student     Student[]
  staff       Staff[]
}

model UserOrganization {
  id             String       @id @default(uuid()) @map("_id") @db.Uuid
  user           User         @relation(fields: [userId], references: [id])
  userId         String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String       @db.Uuid
  branch         Branch?      @relation(fields: [branchId], references: [id])
  branchId       String?      @db.Uuid
}

model AdmissionForm {
  id          String          @id @default(uuid()) @map("_id") @db.Uuid
  student     Student         @relation(fields: [studentId], references: [id])
  studentId   String          @db.Uuid
  createdAt   DateTime?       @default(now())
  updatedAt   DateTime?       @default(now())
  createdBy   User            @relation(fields: [createdById], references: [id])
  createdById String          @db.Uuid
  status      AdmissionStatus
  form        Form            @relation(fields: [formId], references: [id])
  formId      String          @db.Uuid
}

model EnquiryForm {
  id                    String  @id @default(uuid()) @map("_id") @db.Uuid
  name                  String
  date                  String
  emailId               String
  contactNumber         String
  dob                   String
  gender                String
  age                   String
  maritalStatus         String
  fatherName            String
  fatherOccupation      String
  motherName            String
  motherOccupation      String
  guardianName          String
  guardianOccupation    String
  addressLine1          String
  addressLine2          String
  nationality           String
  state                 String
  district              String
  postalCode            String
  schoolName10th        String
  obtainedMark10th      String
  yearOfPassing10th     String
  mediumOfEducation10th String
  schoolName12th        String
  obtainedMark12th      String
  yearOfPassing12th     String
  mediumOfEducation12th String
  form                  Form?   @relation(fields: [formId], references: [id])
  formId                String? @db.Uuid
}

model Department {
  id             String    @id @default(uuid()) @map("_id") @db.Uuid
  departmentName String
  noOfYears      String
  departmentCode String
  isActive       Boolean
  description    String
  course         Course[]
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  branch         Branch?   @relation(fields: [branchId], references: [id])
  branchId       String?   @db.Uuid
}

model Regulation {
  id             String    @id @default(uuid()) @map("_id") @db.Uuid
  regulationName String
  announcedYear  String
  endYear        String?
  isActive       Boolean
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  branch         Branch?   @relation(fields: [branchId], references: [id])
  branchId       String?   @db.Uuid
  Class          Class[]
}

model Course {
  id           String      @id @default(uuid()) @map("_id") @db.Uuid
  courseName   String
  isActive     Boolean
  description  String
  isDeleted    Boolean     @default(false)
  deletedAt    DateTime?
  department   Department? @relation(fields: [departmentId], references: [id])
  departmentId String?     @db.Uuid
}

model Form {
  id             String          @id @default(uuid()) @map("_id") @db.Uuid
  createdAt      DateTime?       @default(now())
  updatedAt      DateTime?       @default(now())
  type           String
  json           Json
  isActive       Boolean         @default(false)
  organization   Organization?   @relation(fields: [organizationId], references: [id])
  organizationId String?         @db.Uuid
  branch         Branch?         @relation(fields: [branchId], references: [id])
  branchId       String?         @db.Uuid
  EnquiryForm    EnquiryForm[]
  Share          Share[]
  Student        Student[]
  AdmissionForm  AdmissionForm[]
}

model Payment {
  id                  String                @id @default(uuid()) @map("_id") @db.Uuid
  transactionId       String
  receipt             String
  amount              String
  paymentDate         String
  paymentMethod       String                @default("Online")
  isActive            Boolean               @default(true)
  isPaid              Boolean               @default(false)
  isDeleted           Boolean               @default(false)
  deletedAt           DateTime?
  PaymentAssociations PaymentAssociations[]
}

model PaymentAssociations {
  id                  String    @id @default(uuid()) @map("_id") @db.Uuid
  associationType     String
  associationEntityId String
  isDeleted           Boolean   @default(false)
  deletedAt           DateTime?
  Payment             Payment?  @relation(fields: [paymentId], references: [id])
  paymentId           String?   @db.Uuid
}

model Share {
  id             String    @id @default(uuid()) @map("_id") @db.Uuid
  isActive       Boolean   @default(true)
  acceptPayment  Boolean   @default(false)
  actualAmount   Float?
  discountAmount Float?
  activeFromDate DateTime?
  activeToDate   DateTime?
  form           Form      @relation(fields: [formId], references: [id])
  formId         String    @db.Uuid
}

model Student {
  id                   String        @id @default(uuid()) @map("_id") @db.Uuid
  firstName            String
  middleName           String
  lastName             String
  emailId              String
  phoneNumber          String
  aadharCardNumber     String
  gender               String
  bloodGroup           String
  dob                  String
  fatherName           String
  fatherOccupation     String
  fatherPhoneNumber    String?
  guardiansOccupation  String
  guardianName         String
  guardianPhoneNumber  String?
  motherName           String
  motherOccupation     String
  motherPhoneNumber    String?
  motherTongue         String
  nationality          String
  religion             String?
  status               StudentStatus
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @default(now())
  additionalAttributes Json

  section        Section?        @relation(fields: [sectionId], references: [id])
  sectionId      String?         @db.Uuid
  userId         String          @unique @db.Uuid
  user           User            @relation(fields: [userId], references: [id])
  branch         Branch          @relation(fields: [branchId], references: [id])
  branchId       String          @db.Uuid
  batch          Batch?          @relation(fields: [batchId], references: [id])
  batchId        String?         @db.Uuid
  organization   Organization    @relation(fields: [organizationId], references: [id])
  organizationId String          @db.Uuid
  form           Form            @relation(fields: [formId], references: [id])
  AdmissionForm  AdmissionForm[]
  formId         String          @db.Uuid

  isDeleted Boolean @default(false)
}

model Staff {
  id               String        @id @default(uuid()) @map("_id") @db.Uuid
  type             StaffType
  aadharCardNumber String
  annualIncome     String
  bloodGroup       String
  dob              String
  address          String
  dateOfJoining    String
  status           StaffStatus
  userId           String        @unique @db.Uuid
  user             User          @relation(fields: [userId], references: [id])
  createdAt        DateTime?     @default(now())
  updatedAt        DateTime?     @default(now())
  Organization     Organization? @relation(fields: [organizationId], references: [id])
  organizationId   String?       @db.Uuid
  Branch           Branch?       @relation(fields: [branchId], references: [id])
  branchId         String?       @db.Uuid
  Section          Section?      @relation(fields: [sectionId], references: [id])
  sectionId        String?       @db.Uuid
}

model Batch {
  id          String    @id @default(uuid()) @map("_id") @db.Uuid
  name        String
  description String?
  startYear   String
  endYear     String
  isActive    Boolean
  isDeleted   Boolean   @default(false)
  class       Class[]
  branch      Branch    @relation(fields: [branchId], references: [id])
  branchId    String    @db.Uuid
  students    Student[]
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @default(now())
}

model Class {
  id           String      @id @default(uuid()) @map("_id") @db.Uuid
  name         String
  description  String?
  isActive     Boolean
  Section      Section[]
  batch        Batch?      @relation(fields: [batchId], references: [id])
  batchId      String?     @db.Uuid
  branch       Branch      @relation(fields: [branchId], references: [id])
  branchId     String      @db.Uuid
  regulation   Regulation? @relation(fields: [regulationId], references: [id])
  regulationId String?     @db.Uuid
  createdAt    DateTime?   @default(now())
  updatedAt    DateTime?   @default(now())
}

model SectionSubject {
  sectionId String  @db.Uuid
  subjectId String  @db.Uuid
  section   Section @relation(fields: [sectionId], references: [id])
  subject   Subject @relation(fields: [subjectId], references: [id])

  @@id([sectionId, subjectId])
}

model Section {
  id              String           @id @default(uuid()) @map("_id") @db.Uuid
  name            String
  description     String?
  faculty         String?
  isActive        Boolean
  medium          Medium           @relation(fields: [mediumId], references: [id])
  mediumId        String           @db.Uuid
  class           Class            @relation(fields: [classId], references: [id])
  staff           Staff[]
  students        Student[]
  classId         String           @db.Uuid
  createdAt       DateTime?        @default(now())
  updatedAt       DateTime?        @default(now())
  sectionSubjects SectionSubject[]
  subjectIds      String[]         @db.Uuid
  Subject         Subject?         @relation(fields: [subjectId], references: [id])
  subjectId       String?          @db.Uuid
}

model Subject {
  id              String           @id @default(uuid()) @map("_id") @db.Uuid
  description     String?
  name            String
  isActive        Boolean
  SubjectType     SubjectType      @relation(fields: [subjectTypeId], references: [id])
  subjectTypeId   String           @db.Uuid
  SubjectFormat   SubjectFormat    @relation(fields: [subjectFormatId], references: [id])
  subjectFormatId String           @db.Uuid
  createdAt       DateTime?        @default(now())
  updatedAt       DateTime?        @default(now())
  Section         Section[]
  sectionId       String[]         @db.Uuid
  SectionSubject  SectionSubject[]
}

model SubjectType {
  id        String    @id @default(uuid()) @map("_id") @db.Uuid
  name      String
  isActive  Boolean
  subject   Subject[]
  branch    Branch    @relation(fields: [branchId], references: [id])
  branchId  String    @db.Uuid
  isDeleted Boolean   @default(false)
  createdAt DateTime? @default(now())
  updatedAt DateTime? @default(now())
}

model SubjectFormat {
  id        String    @id @default(uuid()) @map("_id") @db.Uuid
  name      String
  isActive  Boolean
  subject   Subject[]
  branch    Branch    @relation(fields: [branchId], references: [id])
  branchId  String    @db.Uuid
  isDeleted Boolean   @default(false)
  createdAt DateTime? @default(now())
  updatedAt DateTime? @default(now())
}

model Group {
  id        String    @id @default(uuid()) @map("_id") @db.Uuid
  name      String
  isActive  Boolean
  isDeleted Boolean   @default(false)
  branch    Branch    @relation(fields: [branchId], references: [id])
  branchId  String    @db.Uuid
  createdAt DateTime? @default(now())
  updatedAt DateTime? @default(now())
}

model Medium {
  id        String    @id @default(uuid()) @map("_id") @db.Uuid
  name      String
  isActive  Boolean
  section   Section[]
  isDeleted Boolean   @default(false)
  branch    Branch    @relation(fields: [branchId], references: [id])
  branchId  String    @db.Uuid
  createdAt DateTime? @default(now())
  updatedAt DateTime? @default(now())
}

model Test {
  id           String   @id @default(uuid()) @map("_id") @db.Uuid
  testType     TestType
  testNumber   Int
  studentMarks Json
  outOfMark    String
}

enum StaffType {
  Teaching
  NonTeaching
  Principal
  Correspondent
}

enum TestType {
  UnitTest
  TermTest
  ClassTest
}

enum StudentStatus {
  Pending
  Rejected
  Active
}

enum StaffStatus {
  Active
  InActive
  Resigned
  Suspended
  Fired
}

enum AdmissionStatus {
  Received
  UnderReview
  Waitlisted
  Accepted
  Rejected
  Deferred
  Withdrawn
  Enrolled
  Archived
  DirectStudentEntry
}
