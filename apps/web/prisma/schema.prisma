// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id])
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String    @unique
  emailVerified DateTime?
  username      String?   @unique
  password      String
  phoneNumber   String
  role          UserRole  @default(User)

  image                 String?
  staff                 Staff?
  student               Student?
  accounts              Account[]
  sessions              Session[]
  userOrganizations     UserOrganization[]
  createdBranches       Branch[]
  createdOrganizations  Organization[]
  createdAdmissionForms AdmissionForm[]
}

enum UserRole {
  Admin
  TeachingStaff
  NonTeachingStaff
  Student
  User
}

model Branch {
  id             String             @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  address        String
  organization   Organization       @relation(fields: [organizationId], references: [id])
  organizationId String             @db.ObjectId
  users          UserOrganization[]
  forms          Form[]
  department     Department[]
  regulation     Regulation[]
  isActivated    Boolean            @default(false)
  createdAt      DateTime?          @default(now())
  updatedAt      DateTime?          @default(now())
  createdBy      User               @relation(fields: [createdById], references: [id])
  createdById    String             @db.ObjectId
  Batch          Batch[]
  Student        Student[]
  class          Class[]
  staff          Staff[]
}

model Organization {
  id          String             @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  institute   String
  description String?
  image       String?
  users       UserOrganization[]
  branches    Branch[]
  forms       Form[]
  isActivated Boolean            @default(false)
  createdAt   DateTime?          @default(now())
  updatedAt   DateTime?          @default(now())
  createdBy   User               @relation(fields: [createdById], references: [id])
  createdById String             @db.ObjectId
  Student     Student[]
  staff       Staff[]
}

model UserOrganization {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  user           User         @relation(fields: [userId], references: [id])
  userId         String       @db.ObjectId
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String       @db.ObjectId
  branch         Branch?      @relation(fields: [branchId], references: [id])
  branchId       String?      @db.ObjectId
}

model AdmissionForm {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  student     Student         @relation(fields: [studentId], references: [id])
  studentId   String          @db.ObjectId
  createdAt   DateTime?       @default(now())
  updatedAt   DateTime?       @default(now())
  createdBy   User            @relation(fields: [createdById], references: [id])
  createdById String          @db.ObjectId
  status      AdmissionStatus
  form        Form            @relation(fields: [formId], references: [id])
  formId      String          @db.ObjectId
}

model EnquiryForm {
  id                    String  @id @default(auto()) @map("_id") @db.ObjectId
  name                  String
  date                  String
  emailId               String
  contactNumber         String
  dob                   String
  gender                String
  age                   String
  maritalStatus         String
  fatherName            String
  fatherOccupation      String
  motherName            String
  motherOccupation      String
  guardianName          String
  guardianOccupation    String
  addressLine1          String
  addressLine2          String
  nationality           String
  state                 String
  district              String
  postalCode            String
  schoolName10th        String
  obtainedMark10th      String
  yearOfPassing10th     String
  mediumOfEducation10th String
  schoolName12th        String
  obtainedMark12th      String
  yearOfPassing12th     String
  mediumOfEducation12th String
  form                  Form?   @relation(fields: [formId], references: [id])
  formId                String? @db.ObjectId
}

model Department {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  departmentName String
  noOfYears      String
  departmentCode String
  isActive       Boolean
  description    String
  course         Course[]
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  branch         Branch?   @relation(fields: [branchId], references: [id])
  branchId       String?   @db.ObjectId
}

model Regulation {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  regulationName String
  announcedYear  String
  endYear        String?
  isActive       Boolean
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  branch         Branch?   @relation(fields: [branchId], references: [id])
  branchId       String?   @db.ObjectId
  Class          Class[]
}

model Course {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  courseName   String
  isActive     Boolean
  description  String
  isDeleted    Boolean     @default(false)
  deletedAt    DateTime?
  department   Department? @relation(fields: [departmentId], references: [id])
  departmentId String?     @db.ObjectId
}

model Form {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  createdAt      DateTime?       @default(now())
  updatedAt      DateTime?       @default(now())
  type           String
  json           Json
  isActive       Boolean         @default(false)
  organization   Organization?   @relation(fields: [organizationId], references: [id])
  organizationId String?         @db.ObjectId
  branch         Branch?         @relation(fields: [branchId], references: [id])
  branchId       String?         @db.ObjectId
  EnquiryForm    EnquiryForm[]
  Share          Share[]
  Student        Student[]
  AdmissionForm  AdmissionForm[]
}

model Payment {
  id                  String                @id @default(auto()) @map("_id") @db.ObjectId
  transactionId       String
  receipt             String
  amount              String
  paymentDate         String
  paymentMethod       String                @default("Online")
  isActive            Boolean               @default(true)
  isPaid              Boolean               @default(false)
  isDeleted           Boolean               @default(false)
  deletedAt           DateTime?
  PaymentAssociations PaymentAssociations[]
}

model PaymentAssociations {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  associationType     String
  associationEntityId String
  isDeleted           Boolean   @default(false)
  deletedAt           DateTime?
  Payment             Payment?  @relation(fields: [paymentId], references: [id])
  paymentId           String?   @db.ObjectId
}

model Share {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  isActive       Boolean   @default(true)
  acceptPayment  Boolean   @default(false)
  actualAmount   Float?
  discountAmount Float?
  activeFromDate DateTime?
  activeToDate   DateTime?
  form           Form      @relation(fields: [formId], references: [id])
  formId         String    @db.ObjectId
}

model Student {
  id                   String        @id @default(auto()) @map("_id") @db.ObjectId
  firstName            String
  middleName           String
  lastName             String
  emailId              String
  phoneNumber          String
  aadharCardNumber     String
  gender               String
  bloodGroup           String
  dob                  String
  fatherName           String
  fatherOccupation     String
  fatherPhoneNumber    String?
  guardiansOccupation  String
  guardianName         String
  guardianPhoneNumber  String?
  motherName           String
  motherOccupation     String
  motherPhoneNumber    String?
  motherTongue         String
  nationality          String
  religion             String?
  status               StudentStatus
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @default(now())
  additionalAttributes Json

  section        Section?        @relation(fields: [sectionId], references: [id])
  sectionId      String?         @db.ObjectId
  userId         String          @unique @db.ObjectId
  user           User            @relation(fields: [userId], references: [id])
  branch         Branch          @relation(fields: [branchId], references: [id])
  branchId       String          @db.ObjectId
  batch          Batch?          @relation(fields: [batchId], references: [id])
  batchId        String?         @db.ObjectId
  organization   Organization    @relation(fields: [organizationId], references: [id])
  organizationId String          @db.ObjectId
  form           Form            @relation(fields: [formId], references: [id])
  AdmissionForm  AdmissionForm[]
  formId         String          @db.ObjectId
}

model Staff {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  type             StaffType
  aadharCardNumber String
  annualIncome     String
  bloodGroup       String
  dob              String
  address          String
  dateOfJoining    String
  status           StaffStatus
  userId           String        @unique @db.ObjectId
  user             User          @relation(fields: [userId], references: [id])
  Section          Section[]     @relation(fields: [sectionId], references: [id])
  sectionId        String[]      @db.ObjectId
  createdAt        DateTime?     @default(now())
  updatedAt        DateTime?     @default(now())
  Organization     Organization? @relation(fields: [organizationId], references: [id])
  organizationId   String?       @db.ObjectId
  Branch           Branch?       @relation(fields: [branchId], references: [id])
  branchId         String?       @db.ObjectId
}

model Batch {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  startYear   String
  endYear     String
  isActive    Boolean
  isDeleted   Boolean   @default(false)
  class       Class[]
  branch      Branch    @relation(fields: [branchId], references: [id])
  branchId    String    @db.ObjectId
  students    Student[]
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @default(now())
}

model Class {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  description  String?
  isActive     Boolean
  Section      Section[]
  batch        Batch?      @relation(fields: [batchId], references: [id])
  batchId      String?     @db.ObjectId
  branch       Branch      @relation(fields: [branchId], references: [id])
  branchId     String      @db.ObjectId
  regulation   Regulation? @relation(fields: [regulationId], references: [id])
  regulationId String?     @db.ObjectId
  createdAt    DateTime?   @default(now())
  updatedAt    DateTime?   @default(now())
}

model Section {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  medium      String
  description String?
  faculty     String?
  isActive    Boolean
  class       Class     @relation(fields: [classId], references: [id])
  staff       Staff[]   @relation(fields: [staffId], references: [id])
  staffId     String[]  @db.ObjectId
  students    Student[]
  classId     String    @db.ObjectId
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @default(now())
  subjects    Subject[] @relation(fields: [subjectIds], references: [id])
  subjectIds  String[]  @db.ObjectId
}

model Subject {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  description String?
  name        String
  type        String
  isActive    Boolean
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @default(now())
  Section     Section[] @relation(fields: [sectionId], references: [id])
  sectionId   String[]  @db.ObjectId
}

model Test {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  testType     TestType
  testNumber   Int
  studentMarks Json
  outOfMark    String
}

enum StaffType {
  Teaching
  NonTeaching
  Principal
  Correspondent
}

enum TestType {
  UnitTest
  TermTest
  ClassTest
}

enum StudentStatus {
  Pending
  Rejected
  Active
}

enum StaffStatus {
  Active
  InActive
  Resigned
  Suspended
  Fired
}

enum AdmissionStatus {
  Received
  UnderReview
  Waitlisted
  Accepted
  Rejected
  Deferred
  Withdrawn
  Enrolled
  Archived
  DirectStudentEntry
}
