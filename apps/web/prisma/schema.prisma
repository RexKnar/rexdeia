generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(uuid()) @map("_id") @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
}

model Exam {
  id                      String      @id @default(uuid()) @map("_id") @db.Uuid
  name                    String
  createdAt               DateTime    @default(now())
  examTypeId              String      @db.Uuid
  updatedAt               DateTime    @default(now())
  isDeleted               Boolean     @default(false)
  branchId                String      @db.Uuid
  isActive                Boolean
  markEntryOpenDate       DateTime?
  markEntryEndDate        DateTime?
  markEntryCorrectionDate DateTime?
  blockMarkEntry          Boolean     @default(false)
  termId                  String      @db.Uuid
  batchId                 String      @db.Uuid
  batch                   Batch       @relation(fields: [batchId], references: [id])
  branch                  Branch      @relation(fields: [branchId], references: [id])
  examType                ExamType    @relation(fields: [examTypeId], references: [id])
  term                    Term        @relation(fields: [termId], references: [id])
  examGroup               ExamGroup[]
}

model ExamType {
  id          String   @id @default(uuid()) @map("_id") @db.Uuid
  name        String
  isActive    Boolean
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  branchId    String   @db.Uuid
  frequencyId String
  isDeleted   Boolean  @default(false)
  exam        Exam[]
  branch      Branch   @relation(fields: [branchId], references: [id])
}

model Term {
  id        String   @id @default(uuid()) @map("_id") @db.Uuid
  name      String
  isActive  Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  branchId  String   @db.Uuid
  isDeleted Boolean  @default(false)
  exam      Exam[]
  branch    Branch   @relation(fields: [branchId], references: [id])
}

model ExamGroup {
  id                   String                 @id @default(uuid()) @map("_id") @db.Uuid
  totalMarks           Int?
  classId              String                 @db.Uuid
  examId               String                 @db.Uuid
  sectionId            String                 @db.Uuid
  class                Class                  @relation(fields: [classId], references: [id])
  exam                 Exam                   @relation(fields: [examId], references: [id])
  section              Section                @relation(fields: [sectionId], references: [id])
  examSubject          ExamSubject[]
  ExamSubjectPartition ExamSubjectPartition[]
}

model ExamSubject {
  id                   String                 @id @default(uuid()) @map("_id") @db.Uuid
  subjectId            String                 @db.Uuid
  totalMarks           Decimal                @default(0) @db.Decimal
  examGroupId          String                 @db.Uuid
  convertTo            Decimal                @default(0) @db.Decimal
  minMark              Decimal                @default(0) @db.Decimal
  groupId              String                 @db.Uuid
  examGroup            ExamGroup              @relation(fields: [examGroupId], references: [id])
  group                Group                  @relation(fields: [groupId], references: [id])
  subject              Subject                @relation(fields: [subjectId], references: [id])
  examSubjectPartition ExamSubjectPartition[]
  Mark                 Mark[]
}

model ExamSubjectPartition {
  id                       String           @id @default(uuid()) @map("_id") @db.Uuid
  subjectId                String           @db.Uuid
  minMark                  Decimal          @db.Decimal
  totalMarks               Decimal          @db.Decimal
  partitionName            String?
  examSubjectId            String           @db.Uuid
  assessmentFormatId       String           @db.Uuid
  convertTo                Decimal          @db.Decimal
  excludeSubjectValidation Boolean          @default(false)
  dateToConduct            DateTime
  examGroupId              String           @db.Uuid
  assessmentFormat         AssessmentFormat @relation(fields: [assessmentFormatId], references: [id])
  examGroup                ExamGroup        @relation(fields: [examGroupId], references: [id])
  examSubject              ExamSubject      @relation(fields: [examSubjectId], references: [id])
  subject                  Subject          @relation(fields: [subjectId], references: [id])
  Mark                     Mark[]
}

model Mark {
  id                     String               @id @default(uuid()) @map("_id") @db.Uuid
  mark                   Decimal?             @db.Decimal
  attandance             Int?
  studentId              String               @db.Uuid
  examSubjectId          String               @db.Uuid
  examSubjectPartitionId String               @db.Uuid
  subjectId              String?              @db.Uuid
  assessmentFormatId     String?              @db.Uuid
  SubjectMasterId        String?              @db.Uuid
  userId                 String               @db.Uuid
  updatedAt              DateTime?            @default(now())
  SubjectMaster          SubjectMaster?       @relation(fields: [SubjectMasterId], references: [id])
  AssessmentFormat       AssessmentFormat?    @relation(fields: [assessmentFormatId], references: [id])
  examSubject            ExamSubject          @relation(fields: [examSubjectId], references: [id])
  examSubjectPartition   ExamSubjectPartition @relation(fields: [examSubjectPartitionId], references: [id])
  student                Student              @relation(fields: [studentId], references: [id])
  Subject                Subject?             @relation(fields: [subjectId], references: [id])
  user                   User                 @relation(fields: [userId], references: [id])

  @@unique([studentId, examSubjectId, examSubjectPartitionId])
}

model Session {
  id           String   @id @default(uuid()) @map("_id") @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id])
}

model User {
  id                    String             @id @default(uuid()) @map("_id") @db.Uuid
  name                  String?
  email                 String             @unique
  emailVerified         DateTime?
  username              String?            @unique
  password              String
  phoneNumber           String
  role                  UserRole           @default(User)
  image                 String?
  accounts              Account[]
  createdAdmissionForms AdmissionForm[]
  createdBranches       Branch[]
  Mark                  Mark[]
  createdOrganizations  Organization[]
  sessions              Session[]
  staff                 Staff?
  student               Student?
  userOrganizations     UserOrganization[]
}

model Branch {
  id               String             @id @default(uuid()) @map("_id") @db.Uuid
  name             String
  address          String
  organizationId   String             @db.Uuid
  isActivated      Boolean            @default(false)
  createdAt        DateTime?          @default(now())
  updatedAt        DateTime?          @default(now())
  createdById      String             @db.Uuid
  assessmentFormat AssessmentFormat[]
  Batch            Batch[]
  createdBy        User               @relation(fields: [createdById], references: [id])
  organization     Organization       @relation(fields: [organizationId], references: [id])
  class            Class[]
  department       Department[]
  Exam             Exam[]
  examType         ExamType[]
  forms            Form[]
  grade            Grade[]
  group            Group[]
  medium           Medium[]
  natureOfPosting  NatureOfPosting[]
  regulation       Regulation[]
  staff            Staff[]
  Student          Student[]
  Subject          Subject[]
  SsbjectMaster    SubjectMaster[]
  term             Term[]
  users            UserOrganization[]
  subjectType      subjectType[]
}

model Organization {
  id          String             @id @default(uuid()) @map("_id") @db.Uuid
  name        String
  institute   String
  description String?
  image       String?
  isActivated Boolean            @default(false)
  createdAt   DateTime?          @default(now())
  updatedAt   DateTime?          @default(now())
  createdById String             @db.Uuid
  branches    Branch[]
  forms       Form[]
  createdBy   User               @relation(fields: [createdById], references: [id])
  periods     Periods[]
  staff       Staff[]
  Student     Student[]
  users       UserOrganization[]
}

model UserOrganization {
  id             String       @id @default(uuid()) @map("_id") @db.Uuid
  userId         String       @db.Uuid
  organizationId String       @db.Uuid
  branchId       String?      @db.Uuid
  branch         Branch?      @relation(fields: [branchId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])
}

model AdmissionForm {
  id          String          @id @default(uuid()) @map("_id") @db.Uuid
  studentId   String          @db.Uuid
  createdAt   DateTime?       @default(now())
  updatedAt   DateTime?       @default(now())
  createdById String          @db.Uuid
  status      AdmissionStatus
  formId      String?         @db.Uuid
  createdBy   User            @relation(fields: [createdById], references: [id])
  form        Form?           @relation(fields: [formId], references: [id])
  student     Student         @relation(fields: [studentId], references: [id])
}

model EnquiryForm {
  id                    String  @id @default(uuid()) @map("_id") @db.Uuid
  name                  String
  date                  String
  emailId               String
  contactNumber         String
  dob                   String
  gender                String
  age                   String
  maritalStatus         String
  fatherName            String
  fatherOccupation      String
  motherName            String
  motherOccupation      String
  guardianName          String
  guardianOccupation    String
  addressLine1          String
  addressLine2          String
  nationality           String
  state                 String
  district              String
  postalCode            String
  schoolName10th        String
  obtainedMark10th      String
  yearOfPassing10th     String
  mediumOfEducation10th String
  schoolName12th        String
  obtainedMark12th      String
  yearOfPassing12th     String
  mediumOfEducation12th String
  formId                String? @db.Uuid
  form                  Form?   @relation(fields: [formId], references: [id])
}

model Department {
  id             String    @id @default(uuid()) @map("_id") @db.Uuid
  departmentName String
  noOfYears      String
  departmentCode String
  isActive       Boolean
  description    String
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  branchId       String?   @db.Uuid
  course         Course[]
  branch         Branch?   @relation(fields: [branchId], references: [id])
}

model Regulation {
  id             String    @id @default(uuid()) @map("_id") @db.Uuid
  regulationName String
  announcedYear  String
  endYear        String?
  isActive       Boolean
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  branchId       String?   @db.Uuid
  Class          Class[]
  branch         Branch?   @relation(fields: [branchId], references: [id])
  subject        Subject[]
}

model Course {
  id           String      @id @default(uuid()) @map("_id") @db.Uuid
  courseName   String
  isActive     Boolean
  description  String
  isDeleted    Boolean     @default(false)
  deletedAt    DateTime?
  departmentId String?     @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id])
}

model Form {
  id             String          @id @default(uuid()) @map("_id") @db.Uuid
  createdAt      DateTime?       @default(now())
  updatedAt      DateTime?       @default(now())
  type           String
  json           Json
  isActive       Boolean         @default(false)
  organizationId String?         @db.Uuid
  branchId       String?         @db.Uuid
  AdmissionForm  AdmissionForm[]
  EnquiryForm    EnquiryForm[]
  branch         Branch?         @relation(fields: [branchId], references: [id])
  organization   Organization?   @relation(fields: [organizationId], references: [id])
  Share          Share[]
  Student        Student[]
}

model Payment {
  id                  String                @id @default(uuid()) @map("_id") @db.Uuid
  transactionId       String
  receipt             String
  amount              String
  paymentDate         String
  paymentMethod       String                @default("Online")
  isActive            Boolean               @default(true)
  isPaid              Boolean               @default(false)
  isDeleted           Boolean               @default(false)
  deletedAt           DateTime?
  PaymentAssociations PaymentAssociations[]
}

model PaymentAssociations {
  id                  String    @id @default(uuid()) @map("_id") @db.Uuid
  associationType     String
  associationEntityId String
  isDeleted           Boolean   @default(false)
  deletedAt           DateTime?
  paymentId           String?   @db.Uuid
  Payment             Payment?  @relation(fields: [paymentId], references: [id])
}

model Share {
  id             String    @id @default(uuid()) @map("_id") @db.Uuid
  isActive       Boolean   @default(true)
  acceptPayment  Boolean   @default(false)
  actualAmount   Float?
  discountAmount Float?
  activeFromDate DateTime?
  activeToDate   DateTime?
  formId         String    @db.Uuid
  form           Form      @relation(fields: [formId], references: [id])
}

model Student {
  id                     String                   @id @default(uuid()) @map("_id") @db.Uuid
  firstName              String
  middleName             String?
  lastName               String
  emailId                String
  phoneNumber            String
  aadharCardNumber       String
  gender                 String
  bloodGroup             String?
  dob                    String
  fatherName             String?
  fatherOccupation       String?
  fatherPhoneNumber      String?
  guardiansOccupation    String?
  guardianName           String?
  guardianPhoneNumber    String?
  motherName             String?
  motherOccupation       String?
  motherPhoneNumber      String?
  nationality            String?
  religion               String?
  profileImage           String?
  status                 StudentStatus
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @default(now())
  additionalAttributes   Json
  userId                 String                   @unique @db.Uuid
  branchId               String                   @db.Uuid
  batchId                String?                  @db.Uuid
  organizationId         String                   @db.Uuid
  sectionId              String?                  @db.Uuid
  isDeleted              Boolean                  @default(false)
  formId                 String?                  @db.Uuid
  fatherEmailId          String?
  guardianEmailId        String?
  motherEmailId          String?
  communityId            String?                  @db.Uuid
  motherTongueId         String?                  @db.Uuid
  admissionNumber        String?
  emisNumber             String                   @unique
  AdmissionForm          AdmissionForm[]
  Mark                   Mark[]
  batch                  Batch?                   @relation(fields: [batchId], references: [id])
  branch                 Branch                   @relation(fields: [branchId], references: [id])
  community              Community?               @relation(fields: [communityId], references: [id])
  form                   Form?                    @relation(fields: [formId], references: [id])
  motherTongue           Language?                @relation(fields: [motherTongueId], references: [id])
  organization           Organization             @relation(fields: [organizationId], references: [id])
  section                Section?                 @relation(fields: [sectionId], references: [id])
  user                   User                     @relation(fields: [userId], references: [id])
  StudentElectiveSubject StudentElectiveSubject[]
  studentMapping         StudentMapping[]

  @@index([firstName, lastName, emisNumber, phoneNumber, emailId, aadharCardNumber])
}

model StudentMapping {
  studentId  String   @db.Uuid
  classId    String   @db.Uuid
  sectionId  String?  @db.Uuid
  groupId    String   @db.Uuid
  id         String   @id @default(uuid()) @map("_id") @db.Uuid
  mediumId   String?  @db.Uuid
  batchId    String?  @db.Uuid
  isCurrent  Boolean  @default(true)
  rollNumber Int?     @default(0)
  remark     String?  @default("")
  batch      Batch?   @relation(fields: [batchId], references: [id])
  class      Class    @relation(fields: [classId], references: [id])
  group      Group    @relation(fields: [groupId], references: [id])
  medium     Medium?  @relation(fields: [mediumId], references: [id])
  section    Section? @relation(fields: [sectionId], references: [id])
  student    Student  @relation(fields: [studentId], references: [id])
}

model Staff {
  id                           String                    @id @default(uuid()) @map("_id") @db.Uuid
  image                        String?
  aadharCardNumber             String?
  firstName                    String                    @default("")
  middleName                   String?                   @default("")
  lastName                     String                    @default("")
  dateOfBirth                  DateTime                  @default(now())
  gender                       String                    @default("")
  mobile                       String                    @default("")
  email                        String                    @default("")
  bloodGroup                   String?
  religion                     String?
  nationality                  String?
  specialCategory              String?
  differentlyAbled             Boolean                   @default(false)
  epfNumber                    String?
  fatherName                   String?
  fatherOccupation             String?
  motherName                   String?
  motherOccupation             String?
  spouseName                   String?
  spouseOccupation             String?
  currentAddressLine1          String?
  currentAddressLine2          String?
  currentCity                  String?
  currentState                 String?
  currentCountry               String?
  currentPincode               String?
  permanentAddress1            String?
  permanentAddress2            String?
  permanentCity                String?
  permanentState               String?
  permanentPincode             String?
  permanentCountry             String?
  birthCertificate             String?
  communityCertificate         String?
  childImmunicationCertificate String?
  medicalCertificate           String?
  covidVaccinationCertificate  String?
  characterCertificate         String?
  fathersPhoto                 String?
  mothersPhoto                 String?
  spousePhoto                  String?
  incomeCertificate            String?
  transferCertificate          String?
  sslcMarksCard                String?
  pucMarksCard                 String?
  degreeMarksCard              String?
  pgMarksCard                  String?
  otherCertificate             String?
  dateOfDetainment             DateTime?
  dateOfRegularization         DateTime?
  subjectHandling              String?
  collegeName                  String?
  passOutYear                  DateTime?
  marksObtained                String?
  dateOfJoining                DateTime                  @default(now())
  status                       StaffStatus               @default(Active)
  userId                       String                    @unique @db.Uuid
  createdAt                    DateTime?                 @default(now())
  updatedAt                    DateTime?                 @default(now())
  organizationId               String?                   @db.Uuid
  branchId                     String?                   @db.Uuid
  sectionIds                   String[]                  @db.Uuid
  IFSC_Code                    String?
  accountHolderName            String?
  accountNumber                String?
  age                          String?
  branchName                   String?
  cps                          String?
  dateOfRetirement             DateTime?
  employeeId                   String?
  enrollmentId                 String?
  tpf                          String?
  communityId                  String?                   @db.Uuid
  designationId                String?                   @db.Uuid
  employmentTypeId             String?                   @db.Uuid
  motherTongueId               String?                   @db.Uuid
  natureOfPostingId            String?                   @db.Uuid
  staffCategoryId              String?                   @db.Uuid
  mediumOfTeachingId           String?                   @db.Uuid
  otherSubjectId               String?                   @db.Uuid
  primarySubjectId             String?                   @db.Uuid
  secondarySubjectId           String?                   @db.Uuid
  udiseNumber                  String?
  enrollmentNumber             Int                       @default(autoincrement())
  academicSubjectForStaff      AcademicSubjectForStaff[]
  periods                      Periods[]
  sections                     Section[]
  Branch                       Branch?                   @relation(fields: [branchId], references: [id])
  community                    Community?                @relation(fields: [communityId], references: [id])
  designation                  Designation?              @relation(fields: [designationId], references: [id])
  employmentType               EmploymentType?           @relation(fields: [employmentTypeId], references: [id])
  mediumOfTeaching             Medium?                   @relation(fields: [mediumOfTeachingId], references: [id])
  motherTongue                 Language?                 @relation(fields: [motherTongueId], references: [id])
  natureOfPosting              NatureOfPosting?          @relation(fields: [natureOfPostingId], references: [id])
  Organization                 Organization?             @relation(fields: [organizationId], references: [id])
  otherSubject                 SubjectMaster?            @relation("OtherSubject", fields: [otherSubjectId], references: [id])
  primarySubject               SubjectMaster?            @relation("PrimarySubject", fields: [primarySubjectId], references: [id])
  secondarySubject             SubjectMaster?            @relation("SecondarySubject", fields: [secondarySubjectId], references: [id])
  staffCategory                StaffCategory?            @relation(fields: [staffCategoryId], references: [id])
  user                         User                      @relation(fields: [userId], references: [id])
  staffSections                StaffSection[]
}

model Batch {
  id                      String                    @id @default(uuid()) @map("_id") @db.Uuid
  name                    String
  description             String?
  startYear               String
  endYear                 String
  isActive                Boolean
  isDeleted               Boolean                   @default(false)
  branchId                String                    @db.Uuid
  createdAt               DateTime?                 @default(now())
  updatedAt               DateTime?                 @default(now())
  currentAcademicYear     Boolean                   @default(false)
  AcademicSubjectForStaff AcademicSubjectForStaff[]
  branch                  Branch                    @relation(fields: [branchId], references: [id])
  class                   Class[]
  exams                   Exam[]
  periods                 Periods[]
  students                Student[]
  StudentElectiveSubject  StudentElectiveSubject[]
  StudentMapping          StudentMapping[]
  RangeScales             RangeScales[]
}

model Class {
  id             String           @id @default(uuid()) @map("_id") @db.Uuid
  name           String
  description    String?
  isActive       Boolean
  isDeleted      Boolean          @default(false)
  batchId        String?          @db.Uuid
  branchId       String           @db.Uuid
  regulationId   String?          @db.Uuid
  createdAt      DateTime?        @default(now())
  updatedAt      DateTime?        @default(now())
  classLevelId   String?          @db.Uuid
  gradeId        String?          @db.Uuid
  batch          Batch?           @relation(fields: [batchId], references: [id])
  branch         Branch           @relation(fields: [branchId], references: [id])
  classLevel     ClassLevel?      @relation(fields: [classLevelId], references: [id])
  grade          Grade?           @relation(fields: [gradeId], references: [id])
  regulation     Regulation?      @relation(fields: [regulationId], references: [id])
  ExamGroup      ExamGroup[]
  periods        Periods[]
  Section        Section[]
  studentmapping StudentMapping[]
  subjects       Subject[]
  subjectToGroup SubjectToGroup[]
}

model StaffSection {
  sectionId String    @db.Uuid
  staffId   String    @db.Uuid
  createdAt DateTime? @default(now())
  updatedAt DateTime? @default(now())
  section   Section   @relation(fields: [sectionId], references: [id])
  staff     Staff     @relation(fields: [staffId], references: [id])

  @@id([sectionId, staffId])
}

model AcademicSubjectForStaff {
  staffId        String    @db.Uuid
  subjectId      String?   @db.Uuid
  academicYearId String    @db.Uuid
  sectionId      String    @db.Uuid
  isIncharge     Boolean   @default(false)
  id             String    @id @default(uuid()) @map("_id") @db.Uuid
  deletedAt      DateTime? @db.Timestamp(6)
  academicYear   Batch     @relation(fields: [academicYearId], references: [id])
  section        Section   @relation(fields: [sectionId], references: [id])
  staff          Staff     @relation(fields: [staffId], references: [id])
  subject        Subject?  @relation(fields: [subjectId], references: [id])

  @@unique([academicYearId, staffId, sectionId, subjectId, deletedAt])
}

model Section {
  id                      String                    @id @default(uuid()) @map("_id") @db.Uuid
  name                    String
  description             String?
  faculty                 String?
  isActive                Boolean
  mediumId                String                    @db.Uuid
  classId                 String                    @db.Uuid
  createdAt               DateTime?                 @default(now())
  updatedAt               DateTime?                 @default(now())
  subjectId               String?                   @db.Uuid
  staffId                 String?                   @db.Uuid
  isDeleted               Boolean                   @default(false)
  academicSubjectForStaff AcademicSubjectForStaff[]
  ExamGroup               ExamGroup[]
  periods                 Periods[]
  class                   Class                     @relation(fields: [classId], references: [id])
  medium                  Medium                    @relation(fields: [mediumId], references: [id])
  staff                   Staff?                    @relation(fields: [staffId], references: [id])
  Subject                 Subject?                  @relation(fields: [subjectId], references: [id])
  sectionToGroups         SectionToGroups[]
  staffSections           StaffSection[]
  students                Student[]
  studentMapping          StudentMapping[]
}

model SectionToGroups {
  sectionId String    @db.Uuid
  groupId   String    @db.Uuid
  createdAt DateTime? @default(now())
  updatedAt DateTime? @default(now())
  group     Group     @relation(fields: [groupId], references: [id])
  section   Section   @relation(fields: [sectionId], references: [id])

  @@id([sectionId, groupId])
}

model SubjectMaster {
  id                     String                   @id @default(uuid()) @map("_id") @db.Uuid
  name                   String
  order                  Int?                     @default(1)
  isActive               Boolean
  branchId               String?                  @db.Uuid
  isDeleted              Boolean                  @default(false)
  createdAt              DateTime?                @default(now())
  updatedAt              DateTime?                @default(now())
  Mark                   Mark[]
  otherStaff             Staff[]                  @relation("OtherSubject")
  primaryStaff           Staff[]                  @relation("PrimarySubject")
  secondaryStaff         Staff[]                  @relation("SecondarySubject")
  StudentElectiveSubject StudentElectiveSubject[]
  subject                Subject[]
  branch                 Branch?                  @relation(fields: [branchId], references: [id])
}

model Subject {
  id                        String                      @id @default(uuid()) @map("_id") @db.Uuid
  description               String?
  name                      String
  isActive                  Boolean
  elective                  Int
  createdAt                 DateTime?                   @default(now())
  updatedAt                 DateTime?                   @default(now())
  isDeleted                 Boolean                     @default(false)
  regulationId              String                      @db.Uuid
  sectionId                 String[]                    @db.Uuid
  branchId                  String?                     @db.Uuid
  subjectMasterId           String                      @db.Uuid
  classId                   String                      @db.Uuid
  subjectOrder              Int                         @default(1)
  academicSubjectForStaff   AcademicSubjectForStaff[]
  ExamSubject               ExamSubject[]
  ExamSubjectPartition      ExamSubjectPartition[]
  marks                     Mark[]
  periods                   Periods[]
  Section                   Section[]
  StudentElectiveSubject    StudentElectiveSubject[]
  branch                    Branch?                     @relation(fields: [branchId], references: [id])
  class                     Class                       @relation(fields: [classId], references: [id])
  regulation                Regulation                  @relation(fields: [regulationId], references: [id])
  subjectMaster             SubjectMaster               @relation(fields: [subjectMasterId], references: [id])
  subjectToAssessmentFormat SubjectToAssessmentFormat[]
  subjectToGroup            SubjectToGroup[]
  subjectToSubjectTypes     SubjectToSubjectType[]
}

model StudentElectiveSubject {
  id              String        @id @default(uuid()) @map("_id") @db.Uuid
  studentId       String        @db.Uuid
  subjectMasterId String        @db.Uuid
  subjectId       String        @db.Uuid
  academicYearId  String        @db.Uuid
  deletedAt       DateTime?     @db.Timestamp(6)
  academicYear    Batch         @relation(fields: [academicYearId], references: [id])
  student         Student       @relation(fields: [studentId], references: [id])
  subject         Subject       @relation(fields: [subjectId], references: [id])
  subjectMaster   SubjectMaster @relation(fields: [subjectMasterId], references: [id])

  @@unique([academicYearId, studentId, subjectId, deletedAt])
}

model AssessmentFormat {
  id                        String                      @id @default(uuid()) @map("_id") @db.Uuid
  name                      String
  isActive                  Boolean
  hasMarkEntry              Boolean?
  parentId                  String?                     @db.Uuid
  branchId                  String                      @db.Uuid
  isDeleted                 Boolean                     @default(false)
  createdAt                 DateTime?                   @default(now())
  updatedAt                 DateTime?                   @default(now())
  branch                    Branch                      @relation(fields: [branchId], references: [id])
  parentAssessmentFormat    AssessmentFormat?           @relation("ParentChild", fields: [parentId], references: [id])
  childAssessmentFormats    AssessmentFormat[]          @relation("ParentChild")
  ExamSubjectPartition      ExamSubjectPartition[]
  Mark                      Mark[]
  subjectToAssessmentFormat SubjectToAssessmentFormat[]
}

model SubjectToAssessmentFormat {
  assessmentFormatId String           @db.Uuid
  subjectId          String           @db.Uuid
  createdAt          DateTime?        @default(now())
  updatedAt          DateTime?        @default(now())
  assessmentFormat   AssessmentFormat @relation(fields: [assessmentFormatId], references: [id])
  subject            Subject          @relation(fields: [subjectId], references: [id])

  @@id([assessmentFormatId, subjectId])
}

model SubjectToGroup {
  subjectId String    @db.Uuid
  groupId   String    @db.Uuid
  createdAt DateTime? @default(now())
  updatedAt DateTime? @default(now())
  classId   String    @db.Uuid
  class     Class     @relation(fields: [classId], references: [id])
  group     Group     @relation(fields: [groupId], references: [id])
  subject   Subject   @relation(fields: [subjectId], references: [id])

  @@id([groupId, subjectId])
}

