{
  "expo": {
    "name": "Rexdeia Staff",
    "slug": "rexdeia-staff",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "rexdeia",
    "icon": "./icons/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "updates": {
      "url": "https://u.expo.dev/4bf592ac-7f17-4945-bf51-44c354de012b"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rexdeia.staff",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Rexdeia to access the camera to capture student profile pictures.",
        "NSPhotoLibraryUsageDescription": "Allow Rexdeia to access your photo library to select student profile pictures."
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#09090b"
      },
      "package": "com.rexdeia.staff",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Rexdeia to access your photo library to select student profile pictures.",
          "cameraPermission": "Allow Rexdeia to access the camera to capture student profile pictures."
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "4bf592ac-7f17-4945-bf51-44c354de012b"
      }
    }
  }
}
